@page "/registo"
@inject IAutenticacaoService AutenticacaoService
@inject PerfilService PerfilService
@inject NavigationManager Nav

<PageTitle>Criar Conta - Online Cinema Festival</PageTitle>

<main class="auth-page">
    <section class="auth-shell auth-shell-wide">
        <div class="auth-copy">
            <span class="auth-kicker">Novo perfil</span>
            <h1>Cria a tua entrada.</h1>
            <p>Guarda pais, localidade e dados privados com validacao forte antes de entrares na comunidade.</p>
        </div>

        <div class="auth-card auth-card-wide">
            <div class="auth-card-head">
                <span class="auth-logo">
                    <img src="images/logos/cinehub-icon-cor.png" alt="" />
                </span>
                <div>
                    <h2>Criar conta</h2>
                    <p>Todos os campos principais sao validados.</p>
                </div>
            </div>

            <EditForm Model="_modelo" OnValidSubmit="Registar">
                <DataAnnotationsValidator />
                <ValidationSummary class="auth-validation-summary" />

                <div class="auth-grid">
                    <div class="auth-campo">
                        <label for="name">Nome</label>
                        <InputText id="name" class="auth-input" @bind-Value="_modelo.Name" autocomplete="name" />
                        <ValidationMessage For="@(() => _modelo.Name)" class="auth-erro-campo" />
                    </div>

                    <div class="auth-campo">
                        <label for="email">Email</label>
                        <InputText id="email" class="auth-input" @bind-Value="_modelo.Email" type="email" autocomplete="email" />
                        <ValidationMessage For="@(() => _modelo.Email)" class="auth-erro-campo" />
                    </div>

                    <div class="auth-campo">
                        <label for="phone">Telefone</label>
                        <InputText id="phone" class="auth-input" @bind-Value="_modelo.PhoneNumber" type="tel" autocomplete="tel" />
                        <ValidationMessage For="@(() => _modelo.PhoneNumber)" class="auth-erro-campo" />
                    </div>

                    <div class="auth-campo">
                        <label for="country">Pais/Nacionalidade</label>
                        <InputSelect id="country" class="auth-input" @bind-Value="_modelo.CountryCode">
                            <option value="">Seleciona</option>
                            @foreach (var pais in _paises)
                            {
                                <option value="@pais.Codigo">@pais.Nome</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _modelo.CountryCode)" class="auth-erro-campo" />
                    </div>

                    <div class="auth-campo">
                        <label for="location">Localidade</label>
                        <InputSelect id="location" class="auth-input" @bind-Value="_modelo.Location">
                            <option value="">Seleciona</option>
                            @foreach (var localidade in _localidades)
                            {
                                <option value="@localidade">@localidade</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _modelo.Location)" class="auth-erro-campo" />
                    </div>

                    <div class="auth-campo">
                        <label for="password">Palavra-passe</label>
                        <input id="password"
                               class="auth-input"
                               value="@_modelo.Password"
                               @oninput="AtualizarPassword"
                               type="password"
                               autocomplete="new-password" />
                        <ValidationMessage For="@(() => _modelo.Password)" class="auth-erro-campo" />
                        <ul class="password-rules" aria-label="Regras da palavra-passe">
                            <li class="@RegraCss(TemMinimo)">8 ou mais caracteres</li>
                            <li class="@RegraCss(TemMaiuscula)">Uma maiuscula</li>
                            <li class="@RegraCss(TemMinuscula)">Uma minuscula</li>
                            <li class="@RegraCss(TemNumero)">Um numero</li>
                            <li class="@RegraCss(TemSimbolo)">Um simbolo</li>
                        </ul>
                    </div>

                    <div class="auth-campo auth-campo-full">
                        <label for="confirm-password">Confirmar palavra-passe</label>
                        <InputText id="confirm-password" class="auth-input" @bind-Value="_modelo.ConfirmPassword" type="password" autocomplete="new-password" />
                        <ValidationMessage For="@(() => _modelo.ConfirmPassword)" class="auth-erro-campo" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_erro))
                {
                    <p class="auth-erro-geral" role="alert">@_erro</p>
                }

                <button type="submit" class="btn-auth" disabled="@_aSubmeter">
                    @(_aSubmeter ? "A criar conta..." : "Criar conta")
                </button>
            </EditForm>

            <p class="auth-rodape">
                Ja tens conta? <a href="/login">Entrar</a>
            </p>
        </div>
    </section>
</main>

@code {
    private readonly PedidoRegistoDTO _modelo = new();
    private string? _erro;
    private bool _aSubmeter;
    private List<PaisOpcao> _paises = PaisesPadrao;
    private List<string> _localidades = LocalidadesPadrao.ToList();

    private static readonly List<PaisOpcao> PaisesPadrao =
    [
        new("PT", "Portugal"),
        new("BR", "Brasil"),
        new("AO", "Angola"),
        new("CV", "Cabo Verde"),
        new("MZ", "Mocambique"),
        new("ES", "Espanha"),
        new("FR", "Franca"),
        new("IT", "Italia"),
        new("DE", "Alemanha"),
        new("GB", "Reino Unido"),
        new("US", "Estados Unidos"),
    ];

    private static readonly string[] LocalidadesPadrao =
    [
        "Funchal",
        "Camara de Lobos",
        "Machico",
        "Santa Cruz",
        "Ribeira Brava",
        "Lisboa",
        "Porto",
        "Coimbra",
        "Braga",
        "Setubal",
        "Madrid",
        "Paris",
        "Roma",
        "Berlim",
        "Londres",
    ];

    private bool TemMinimo => _modelo.Password.Length >= 8;
    private bool TemMaiuscula => _modelo.Password.Any(char.IsUpper);
    private bool TemMinuscula => _modelo.Password.Any(char.IsLower);
    private bool TemNumero => _modelo.Password.Any(char.IsDigit);
    private bool TemSimbolo => _modelo.Password.Any(c => !char.IsLetterOrDigit(c));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var opcoes = await PerfilService.ObterOpcoesAsync();

            if (opcoes.Paises.Count > 0)
                _paises = opcoes.Paises.Select(p => new PaisOpcao(p.Codigo, p.Nome)).ToList();

            if (opcoes.Localidades.Count > 0)
                _localidades = opcoes.Localidades;
        }
        catch
        {
            // Mantem opcoes locais se a API ainda estiver indisponivel.
        }
    }

    private async Task Registar()
    {
        _erro = null;
        _aSubmeter = true;

        try
        {
            _modelo.Nationality = _paises.FirstOrDefault(p => p.Codigo == _modelo.CountryCode)?.Nome ?? string.Empty;
            await AutenticacaoService.RegistarAsync(_modelo);
            Nav.NavigateTo("/perfil");
        }
        catch (Exception ex)
        {
            _erro = MensagemErroApi.Limpar(ex.Message, "Nao foi possivel criar a conta.");
        }
        finally
        {
            _aSubmeter = false;
        }
    }

    private static string RegraCss(bool valida) => valida ? "ok" : string.Empty;

    private void AtualizarPassword(ChangeEventArgs e)
    {
        _modelo.Password = e.Value?.ToString() ?? string.Empty;
    }

    private sealed record PaisOpcao(string Codigo, string Nome);
}
