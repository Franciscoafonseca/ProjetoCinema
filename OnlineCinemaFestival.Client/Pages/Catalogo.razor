@page "/catalogo"
@inherits FilmePageBase
@inject IConsultaFilmeService FilmeService
@inject TmdbService TmdbService
@inject FestivalService FestivalService
@inject NavigationManager Nav

<PageTitle>Catalogo - Online Cinema Festival</PageTitle>

<main class="cinema-page catalogo-page">
    <section class="cinema-shell">
        <header class="cinema-page-head">
            <div>
                <span class="cinema-kicker">Catalogo</span>
                <h1>Explora o catalogo do festival</h1>
                <p>Pesquisa filmes disponiveis e descobre resultados externos quando ainda nao existem no catalogo.</p>
            </div>
        </header>

        <section class="cinema-panel search-panel">
            <MudTextField T="string"
                          Value="_pesquisa"
                          ValueChanged="OnPesquisaAlterada"
                          Label="Pesquisar filmes"
                          Placeholder="Escreve o nome de um filme"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          DebounceInterval="350"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />

            @if (!string.IsNullOrWhiteSpace(_erroPesquisa))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_erroPesquisa</MudAlert>
            }
            else if (_pesquisaAtiva && _resultadosInternosPesquisa.Count > 0)
            {
                <div class="search-note success">Resultados encontrados no catalogo interno.</div>
            }
            else if (_pesquisaAtiva && _aPesquisarTmdb)
            {
                <div class="search-note">Sem resultados internos. A procurar no TMDB...</div>
            }
        </section>

        @if (_loading)
        {
            <div class="cinema-state">
                <div class="spinner"></div>
                <p>A carregar filmes...</p>
            </div>
        }
        else if (_erro != null)
        {
            <div class="cinema-state error">@_erro</div>
        }
        else if (_pesquisaAtiva)
        {
            @if (_resultadosInternosPesquisa.Count > 0)
            {
                <section class="catalogo-section">
                    <div class="cinema-section-head">
                        <div>
                            <span class="cinema-kicker">Catalogo interno</span>
                            <h2>Resultados no catalogo</h2>
                        </div>
                    </div>

                    <div class="catalogo-grid">
                        @foreach (var filme in _resultadosInternosPesquisa)
                        {
                            <FilmeCard Filme="filme" />
                        }
                    </div>
                </section>
            }
            else
            {
                <section class="catalogo-section">
                    <div class="cinema-section-head">
                        <div>
                            <span class="cinema-kicker">TMDB</span>
                            <h2>Resultados externos</h2>
                        </div>
                    </div>

                    @if (_aPesquisarTmdb)
                    {
                        <div class="cinema-state slim">
                            <div class="spinner"></div>
                            <p>A procurar no TMDB...</p>
                        </div>
                    }
                    else if (_resultadosTmdb.Count == 0)
                    {
                        <div class="cinema-state">Nenhum resultado encontrado.</div>
                    }
                    else
                    {
                        <div class="tmdb-grid">
                            @foreach (var filme in _resultadosTmdb)
                            {
                                var existente = FilmeJaExiste(filme);

                                <article class="tmdb-card" @onclick="() => AbrirResultadoTmdb(filme)">
                                    <div class="tmdb-poster">
                                        <img src="@ImagemFilme(filme)" alt="@filme.Titulo" />
                                        @if (existente)
                                        {
                                            <span class="catalog-badge">No catalogo</span>
                                        }
                                    </div>

                                    <div class="tmdb-body">
                                        <div class="tmdb-meta">
                                            <span>@AnoFilme(filme)</span>
                                            @if (!string.IsNullOrWhiteSpace(GeneroFilme(filme)))
                                            {
                                                <span>@GeneroFilme(filme)</span>
                                            }
                                        </div>
                                        <h3>@filme.Titulo</h3>
                                        <p>@SinopseCurta(filme)</p>

                                        <div class="tmdb-actions">
                                            @if (existente)
                                            {
                                                <button type="button" class="cinema-btn secondary" @onclick="() => AbrirExistente(filme)">
                                                    Abrir no catalogo
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="cinema-btn secondary"
                                                        @onclick="() => AbrirTmdb(filme.TmdbId)">
                                                    Ver detalhe TMDB
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
        }
        else
        {
            <section class="catalogo-section">
                <div class="cinema-section-head">
                    <div>
                        <span class="cinema-kicker">Catalogo interno</span>
                        <h2>Filmes disponiveis</h2>
                    </div>
                    <div class="catalogo-filters">
                        <MudSelect T="int"
                                   Value="_ordenarPor"
                                   ValueChanged="OnOrdenacaoAlterada"
                                   Label="Ordenar"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="int" Value="2">Popularidade</MudSelectItem>
                            <MudSelectItem T="int" Value="3">Classificacao</MudSelectItem>
                            <MudSelectItem T="int" Value="1">Titulo</MudSelectItem>
                            <MudSelectItem T="int" Value="4">Lancamento</MudSelectItem>
                            <MudSelectItem T="int" Value="6">Festival</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="int?"
                                   Value="_festivalSelecionadoId"
                                   ValueChanged="OnFestivalAlterado"
                                   Label="Festival"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="int?" Value="null">Todos</MudSelectItem>
                            @foreach (var festival in _festivais)
                            {
                                <MudSelectItem T="int?" Value="@festival.Id">@festival.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudMenu Label="@RotuloFiltro()"
                                 Variant="Variant.Outlined"
                                 Color="Color.Secondary"
                                 StartIcon="@Icons.Material.Filled.FilterList">
                            @if (_generosSelecionados.Count > 0)
                            {
                                <MudMenuItem OnClick="LimparGeneros" AutoClose="false">Limpar selecao</MudMenuItem>
                                <MudDivider />
                            }
                            @foreach (var genero in _generos)
                            {
                                <MudMenuItem OnClick="() => AlternarGenero(genero)" AutoClose="false">
                                    @(_generosSelecionados.Contains(genero) ? $"Selecionado - {genero}" : genero)
                                </MudMenuItem>
                            }
                        </MudMenu>
                    </div>
                </div>

                @if (_filmesFiltrados.Count == 0)
                {
                    <div class="cinema-state">Nenhum filme interno encontrado.</div>
                }
                else
                {
                    <div class="catalogo-grid">
                        @foreach (var filme in _filmesFiltrados)
                        {
                            <FilmeCard Filme="filme" />
                        }
                    </div>
                }
            </section>
        }
    </section>
</main>

@code {
    private List<FilmeDTO> _filmesInternos = new();
    private List<FilmeDTO> _filmesFiltrados = new();
    private List<FilmeDTO> _resultadosInternosPesquisa = new();
    private List<FilmeDTO> _resultadosTmdb = new();
    private List<string> _generos = new();
    private List<FestivalDTO> _festivais = new();
    private readonly HashSet<string> _generosSelecionados = new(StringComparer.OrdinalIgnoreCase);
    private int _ordenarPor = 2;
    private int? _festivalSelecionadoId;
    private string? _pesquisa;
    private string? _erroPesquisa;
    private bool _pesquisaAtiva;
    private bool _aPesquisarTmdb;

    protected override async Task CarregarDadosAsync()
    {
        _festivais = await FestivalService.ObterFestivaisAsync();
        _filmesInternos = await FilmeService.ObterFilmesAsync(
            ordenarPor: _ordenarPor,
            descendente: true,
            festivalId: _festivalSelecionadoId
        );
        _filmesFiltrados = _filmesInternos.ToList();
        _generos = ExtrairGeneros(_filmesInternos).ToList();
    }

    private async Task OnPesquisaAlterada(string? valor)
    {
        _pesquisa = valor;
        _erroPesquisa = null;

        var termo = _pesquisa?.Trim() ?? string.Empty;
        if (termo.Length < 2)
        {
            _pesquisaAtiva = false;
            _aPesquisarTmdb = false;
            _resultadosInternosPesquisa.Clear();
            _resultadosTmdb.Clear();
            await AplicarFiltrosInternos();
            return;
        }

        _pesquisaAtiva = true;
        _resultadosTmdb.Clear();

        try
        {
            var internos = await FilmeService.ObterFilmesAsync(
                pesquisa: termo,
                ordenarPor: _ordenarPor,
                descendente: true,
                festivalId: _festivalSelecionadoId
            );
            _resultadosInternosPesquisa = FiltrarPorGeneros(internos).ToList();

            if (_resultadosInternosPesquisa.Count > 0)
                return;

            _aPesquisarTmdb = true;
            await InvokeAsync(StateHasChanged);
            _resultadosTmdb = (await TmdbService.PesquisarAsync(termo)).ToList();
        }
        catch (Exception ex)
        {
            _erroPesquisa = MensagemErroApi.Limpar(
                ex.Message,
                "Nao foi possivel concluir a pesquisa. Tenta novamente."
            );
            _resultadosInternosPesquisa.Clear();
            _resultadosTmdb.Clear();
        }
        finally
        {
            _aPesquisarTmdb = false;
        }
    }

    private void AbrirExistente(FilmeDTO filme)
    {
        var existente = _filmesInternos.FirstOrDefault(f => f.TmdbId == filme.TmdbId);
        if (existente != null)
            Nav.NavigateTo($"/filmes/{existente.Id}");
    }

    private void AbrirTmdb(int tmdbId)
    {
        if (tmdbId > 0)
            Nav.NavigateTo($"/tmdb/filmes/{tmdbId}");
    }

    private void AbrirResultadoTmdb(FilmeDTO filme)
    {
        if (FilmeJaExiste(filme))
            AbrirExistente(filme);
        else
            AbrirTmdb(filme.TmdbId);
    }

    private async Task AlternarGenero(string genero)
    {
        if (!_generosSelecionados.Add(genero))
            _generosSelecionados.Remove(genero);

        if (_pesquisaAtiva)
            await OnPesquisaAlterada(_pesquisa);
        else
            await AplicarFiltrosInternos();
    }

    private async Task LimparGeneros()
    {
        _generosSelecionados.Clear();

        if (_pesquisaAtiva)
            await OnPesquisaAlterada(_pesquisa);
        else
            await AplicarFiltrosInternos();
    }

    private Task AplicarFiltrosInternos()
    {
        _filmesFiltrados = FiltrarPorGeneros(_filmesInternos).ToList();
        return Task.CompletedTask;
    }

    private async Task OnOrdenacaoAlterada(int valor)
    {
        _ordenarPor = valor;
        await RecarregarCatalogoAsync();
    }

    private async Task OnFestivalAlterado(int? valor)
    {
        _festivalSelecionadoId = valor;
        await RecarregarCatalogoAsync();
    }

    private async Task RecarregarCatalogoAsync()
    {
        _filmesInternos = await FilmeService.ObterFilmesAsync(
            ordenarPor: _ordenarPor,
            descendente: true,
            festivalId: _festivalSelecionadoId
        );
        _generos = ExtrairGeneros(_filmesInternos).ToList();
        await AplicarFiltrosInternos();

        if (_pesquisaAtiva)
            await OnPesquisaAlterada(_pesquisa);
    }

    private IEnumerable<FilmeDTO> FiltrarPorGeneros(IEnumerable<FilmeDTO> filmes)
    {
        if (_generosSelecionados.Count == 0)
            return filmes;

        return filmes
            .Select((filme, indice) => new
            {
                Filme = filme,
                Indice = indice,
                Correspondencias = ContarGenerosEmComum(filme),
            })
            .Where(item => item.Correspondencias > 0)
            .OrderByDescending(item => item.Correspondencias)
            .ThenBy(item => item.Indice)
            .Select(item => item.Filme);
    }

    private int ContarGenerosEmComum(FilmeDTO filme)
    {
        var generos = GenerosDoFilme(filme).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return _generosSelecionados.Count(generos.Contains);
    }

    private bool FilmeJaExiste(FilmeDTO filme)
    {
        return filme.TmdbId > 0 && _filmesInternos.Any(f => f.TmdbId == filme.TmdbId);
    }

    private static IEnumerable<string> ExtrairGeneros(IEnumerable<FilmeDTO> filmes)
    {
        return filmes.SelectMany(GenerosDoFilme)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g);
    }

    private static IEnumerable<string> GenerosDoFilme(FilmeDTO filme)
    {
        if (filme.Generos.Count > 0)
            return filme.Generos.Where(g => !string.IsNullOrWhiteSpace(g));

        if (string.IsNullOrWhiteSpace(filme.Genero))
            return Array.Empty<string>();

        return filme.Genero.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(g => g.Trim())
            .Where(g => g.Length > 0);
    }

    private string RotuloFiltro()
    {
        return _generosSelecionados.Count switch
        {
            0 => "Filtrar por genero",
            1 => _generosSelecionados.First(),
            _ => $"{_generosSelecionados.Count} generos",
        };
    }

    private static string ImagemFilme(FilmeDTO filme)
    {
        return string.IsNullOrWhiteSpace(filme.CapaUrl)
            ? "images/placeholders/poster-placeholder.svg"
            : filme.CapaUrl;
    }

    private static string AnoFilme(FilmeDTO filme)
    {
        return filme.DataLancamento == default ? "N/D" : filme.DataLancamento.Year.ToString();
    }

    private static string GeneroFilme(FilmeDTO filme)
    {
        if (filme.Generos.Count > 0)
            return string.Join(", ", filme.Generos.Take(2));

        return filme.Genero ?? string.Empty;
    }

    private static string SinopseCurta(FilmeDTO filme)
    {
        if (string.IsNullOrWhiteSpace(filme.Sinopse))
            return "Sem sinopse disponivel.";

        return filme.Sinopse.Length <= 150 ? filme.Sinopse : filme.Sinopse[..150] + "...";
    }
}
