@page "/perfis/{UtilizadorId:int}"
@page "/perfil/{UtilizadorId:int}"
@inject PerfilService PerfilService
@inject NavigationManager Nav

<PageTitle>Perfil publico - Online Cinema Festival</PageTitle>

<main class="cinema-page perfil-publico-page">
    <section class="cinema-shell">
        @if (_aCarregar)
        {
            <div class="cinema-state">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <p>A carregar perfil publico...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_erro))
        {
            <div class="cinema-state error">
                <p>@_erro</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Voltar">
                    Voltar ao catalogo
                </MudButton>
            </div>
        }
        else if (_perfil is not null)
        {
            <header class="cinema-page-head perfil-publico-head">
                <div>
                    <span class="cinema-kicker">Perfil publico</span>
                    <h1>@_perfil.Name</h1>
                    <p>@DescricaoPerfil</p>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="Voltar">
                    Voltar
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Report"
                           Disabled="@_aReportar"
                           OnClick="AbrirReporte">
                    Reportar utilizador
                </MudButton>
            </header>

            @if (!string.IsNullOrWhiteSpace(_mensagemReporte))
            {
                <MudAlert Severity="@_severidadeReporte" Variant="Variant.Filled">
                    @_mensagemReporte
                </MudAlert>
            }

            @if (_mostrarReporte)
            {
                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Reportar perfil</MudText>
                        <EditForm Model="_reporte" OnValidSubmit="EnviarReporteAsync">
                            <DataAnnotationsValidator />
                            <MudTextField T="string"
                                          Label="Motivo"
                                          Lines="4"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_reporte.Motivo" />
                            <ValidationMessage For="@(() => _reporte.Motivo)" />
                            <MudStack Row="true" Spacing="2" Class="perfil-publico-report-actions">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           OnClick="CancelarReporte">
                                    Cancelar
                                </MudButton>
                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Error"
                                           Disabled="@_aReportar">
                                    @(_aReportar ? "A enviar..." : "Enviar reporte")
                                </MudButton>
                            </MudStack>
                        </EditForm>
                    </MudCardContent>
                </MudCard>
            }

            <section class="perfil-publico-grid">
                <MudCard Elevation="0" Class="cinema-panel perfil-publico-avatar">
                    <MudCardContent>
                        @if (MostrarFotoPerfil)
                        {
                            <img src="@_perfil.ProfileImageUrl" alt="@_perfil.Name" @onerror="MarcarFotoPerfilFalhada" />
                        }
                        else
                        {
                            <div class="perfil-publico-iniciais">@Iniciais</div>
                        }
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="cinema-panel perfil-publico-info">
                    <MudCardContent>
                        <MudStack Spacing="3">
                            <MudStack Row="true" Class="perfil-publico-chips">
                                @if (!string.IsNullOrWhiteSpace(_perfil.Nationality))
                                {
                                    <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                                        @BandeiraPerfil @_perfil.Nationality
                                    </MudChip>
                                }
                                @if (!string.IsNullOrWhiteSpace(_perfil.Location))
                                {
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
                                        @_perfil.Location
                                    </MudChip>
                                }
                            </MudStack>

                            <MudText Typo="Typo.h5">Atividade</MudText>
                            <div class="perfil-publico-metricas">
                                <article>
                                    <strong>@_perfil.ReviewsCount</strong>
                                    <span>Avaliacoes</span>
                                </article>
                                <article>
                                    <strong>@_perfil.CommunitiesCount</strong>
                                    <span>Comunidades</span>
                                </article>
                                <article>
                                    <strong>@_perfil.PublicListsCount</strong>
                                    <span>Listas publicas</span>
                                </article>
                            </div>

                            <div>
                                <MudText Typo="Typo.h6">Generos favoritos</MudText>
                                @if (_perfil.FavoriteGenres.Count == 0)
                                {
                                    <MudText Color="Color.Secondary">Sem generos favoritos publicos.</MudText>
                                }
                                else
                                {
                                    <MudStack Row="true" Class="perfil-publico-chips">
                                        @foreach (var genero in _perfil.FavoriteGenres)
                                        {
                                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                                                @genero
                                            </MudChip>
                                        }
                                    </MudStack>
                                }
                            </div>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </section>

            <section class="perfil-publico-grid">
                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Listas publicas</MudText>
                        @if (_perfil.PublicLists.Count == 0)
                        {
                            <MudText Color="Color.Secondary">Sem listas publicas.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var lista in _perfil.PublicLists)
                                {
                                    <MudPaper Elevation="0" Class="perfil-publico-item">
                                        <strong>@lista.Name</strong>
                                        <span>@(lista.TotalFilmes == 1 ? "1 filme" : $"{lista.TotalFilmes} filmes")</span>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Reviews publicas</MudText>
                        @if (_perfil.PublicReviews.Count == 0)
                        {
                            <MudText Color="Color.Secondary">Sem reviews publicas.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var review in _perfil.PublicReviews.Take(5))
                                {
                                    <button class="perfil-publico-item link"
                                            type="button"
                                            @onclick="() => AbrirFilme(review.FilmeId)">
                                        <strong>@review.FilmeTitulo</strong>
                                        <span>@review.Pontuacao/10 - @review.Texto</span>
                                    </button>
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Comunidades publicas</MudText>
                        @if (_perfil.PublicCommunities.Count == 0)
                        {
                            <MudText Color="Color.Secondary">Sem comunidades publicas.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var comunidade in _perfil.PublicCommunities)
                                {
                                    <button class="perfil-publico-item link"
                                            type="button"
                                            @onclick="() => AbrirComunidade(comunidade.Id)">
                                        <strong>@comunidade.Name</strong>
                                        <span>@comunidade.MembersCount membros</span>
                                    </button>
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>
            </section>
        }
    </section>
</main>

@code {
    [Parameter] public int UtilizadorId { get; set; }

    private PerfilPublicoDTO? _perfil;
    private CriarReporteUtilizadorDTO _reporte = new();
    private bool _aCarregar = true;
    private bool _aReportar;
    private bool _mostrarReporte;
    private bool _fotoPerfilFalhou;
    private string? _erro;
    private string? _mensagemReporte;
    private Severity _severidadeReporte = Severity.Info;

    private string DescricaoPerfil =>
        string.IsNullOrWhiteSpace(_perfil?.Bio)
            ? "Membro da comunidade Online Cinema Festival."
            : _perfil.Bio;

    private string Iniciais
    {
        get
        {
            var partes = (_perfil?.Name ?? "OCF")
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            return string.Concat(partes.Take(2).Select(p => p[0])).ToUpperInvariant();
        }
    }

    private bool MostrarFotoPerfil =>
        _perfil is not null
        && !string.IsNullOrWhiteSpace(_perfil.ProfileImageUrl)
        && !_fotoPerfilFalhou;

    private string BandeiraPerfil =>
        !string.IsNullOrWhiteSpace(_perfil?.CountryFlag)
            ? _perfil.CountryFlag
            : ObterBandeira(_perfil?.CountryCode ?? string.Empty);

    protected override async Task OnParametersSetAsync()
    {
        _aCarregar = true;
        _erro = null;
        _mensagemReporte = null;
        _mostrarReporte = false;

        try
        {
            _perfil = await PerfilService.ObterPerfilPublicoAsync(UtilizadorId);
            _fotoPerfilFalhou = false;

            if (_perfil is null)
                _erro = "Perfil publico nao encontrado ou indisponivel.";
        }
        catch
        {
            _erro = "Nao foi possivel carregar o perfil publico.";
        }
        finally
        {
            _aCarregar = false;
        }
    }

    private void Voltar()
    {
        Nav.NavigateTo("/catalogo");
    }

    private void AbrirReporte()
    {
        _reporte = new CriarReporteUtilizadorDTO();
        _mensagemReporte = null;
        _mostrarReporte = true;
    }

    private void CancelarReporte()
    {
        _mostrarReporte = false;
        _mensagemReporte = null;
    }

    private async Task EnviarReporteAsync()
    {
        _aReportar = true;
        _mensagemReporte = null;

        try
        {
            await PerfilService.ReportarUtilizadorAsync(UtilizadorId, _reporte);
            _mostrarReporte = false;
            _mensagemReporte = "Reporte enviado. A equipa de administracao vai analisar o caso.";
            _severidadeReporte = Severity.Success;
        }
        catch (Exception ex)
        {
            _mensagemReporte = MensagemErroApi.Limpar(ex.Message, "Nao foi possivel enviar o reporte.");
            _severidadeReporte = Severity.Error;
        }
        finally
        {
            _aReportar = false;
        }
    }

    private void AbrirFilme(int filmeId)
    {
        Nav.NavigateTo($"/filmes/{filmeId}");
    }

    private void AbrirComunidade(Guid comunidadeId)
    {
        Nav.NavigateTo($"/comunidades/{comunidadeId}");
    }

    private void MarcarFotoPerfilFalhada()
    {
        _fotoPerfilFalhou = true;
    }

    private static string ObterBandeira(string countryCode)
    {
        if (string.IsNullOrWhiteSpace(countryCode))
            return string.Empty;

        var codigo = countryCode.Trim().ToUpperInvariant();

        if (codigo.Length != 2 || codigo.Any(c => c < 'A' || c > 'Z'))
            return string.Empty;

        return string.Concat(codigo.Select(c => char.ConvertFromUtf32(0x1F1E6 + c - 'A')));
    }
}
