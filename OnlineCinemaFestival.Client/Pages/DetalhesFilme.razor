    private async Task AtualizarUtilizadorAtualAsync()
    {
        var estado = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = estado.User;

        _nomeUtilizadorAtual = user.Identity?.Name ?? string.Empty;
        _utilizadorAtualId = ObterClaimInt(user, ClaimTypes.NameIdentifier)
            ?? ObterClaimInt(user, "nameid")
            ?? ObterClaimInt(user, "sub");
    }

    private void PrepararReviewAtual()
    {
        _minhaReview = _utilizadorAtualId.HasValue
            ? _filme?.ReviewsAplicacao.FirstOrDefault(r => r.UsuarioId == _utilizadorAtualId.Value)
            : null;

        _novaReview = _minhaReview == null
            ? new CriarAvaliacaoDTO { Pontuacao = 8 }
            : new CriarAvaliacaoDTO
            {
                Pontuacao = _minhaReview.Pontuacao,
                Texto = _minhaReview.Texto,
            };
    }

    private void AplicarReviewNaLista(AvaliacaoDTO review)
    {
        if (_filme == null)
            return;

        if (string.IsNullOrWhiteSpace(review.NomeUsuario))
            review.NomeUsuario = string.IsNullOrWhiteSpace(_nomeUtilizadorAtual)
                ? "Utilizador"
                : _nomeUtilizadorAtual;

        var existente = _filme.ReviewsAplicacao.FindIndex(r => r.Id == review.Id);
        if (existente >= 0)
            _filme.ReviewsAplicacao[existente] = review;
        else
            _filme.ReviewsAplicacao.Insert(0, review);

        _filme.AvaliacoesInternasTotal = _filme.ReviewsAplicacao.Count;
        _filme.AvaliacaoInternaMedia = _filme.ReviewsAplicacao.Average(r => r.Pontuacao);
    }

    private void ValidarNovaListaRapida()
    {
        var nome = _novaListaRapida.Name?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(nome))
            throw new InvalidOperationException("O nome da lista e obrigatorio.");

        if (nome.Length < 3)
            throw new InvalidOperationException("O nome da lista deve ter pelo menos 3 caracteres.");

        if (!System.Text.RegularExpressions.Regex.IsMatch(nome, @"^[\p{L}\p{N}\s._'-]+$"))
            throw new InvalidOperationException("O nome da lista contem caracteres invalidos.");

        if (_listas.Any(l => l.Name.Equals(nome, StringComparison.OrdinalIgnoreCase)))
            throw new InvalidOperationException("Ja existe uma lista com esse nome.");

        _novaListaRapida.Name = nome;
        _novaListaRapida.Tipo = TipoListaPessoal.Custom;
    }

    private static int? ObterClaimInt(ClaimsPrincipal user, string tipo)
    {
        var valor = user.FindFirst(tipo)?.Value;
        return int.TryParse(valor, out var id) ? id : null;
    }

    private async Task VotarPremio(int premioId)
    {
        _aVotar = true;
        _mensagemVoto = null;

        try
        {
            await PremioFestivalService.VotarAsync(premioId, Id);
            _mensagemVotoSeveridade = Severity.Success;
            _mensagemVoto = "Voto registado.";
        }
        catch (Exception ex)
        {
            _mensagemVotoSeveridade = Severity.Error;
            _mensagemVoto = ex.Message;
        }
        finally
        {
            _aVotar = false;
        }
    }

    private async Task<List<PremioFestivalDTO>> ObterPremiosVotacaoAsync()
    {
        if (_filme == null)
            return new();

        var premios = new List<PremioFestivalDTO>();

        foreach (var festival in _filme.Festivais)
        {
            try
            {
                var doFestival = await PremioFestivalService.ObterPremiosPorFestivalAsync(festival.Id);
                premios.AddRange(doFestival.Where(p =>
                    p.EstadoPremio.Equals("Aberto", StringComparison.OrdinalIgnoreCase)
                ));
            }
            catch
            {
                // Premios indisponiveis nao devem bloquear o detalhe do filme.
            }
        }

        return premios;
    }

