@page "/historico"
@inject NavigationManager Nav

<PageTitle>Historico - Online Cinema Festival</PageTitle>

<main class="cinema-page">
    <section class="cinema-shell">
        <div class="cinema-state">A abrir o historico de compras...</div>
    </section>
</main>

@code {
    protected override void OnInitialized()
    {
        Nav.NavigateTo("/compras", replace: true);
    }
}
