@page "/sessoes"
@inherits FilmePageBase
@inject SessaoService SessaoService
@inject ICarrinhoService CarrinhoService
@inject NavigationManager Nav

<PageTitle>Sessoes - Online Cinema Festival</PageTitle>

<div class="sessoes-page">
    <header class="page-heading">
        <div class="heading-copy">
            <p class="eyebrow">Programacao digital</p>
            <h1>Sessoes</h1>
            <p class="lead">Escolhe uma exibicao, compra o bilhete e entra no player quando tiveres acesso.</p>
            <div class="heading-actions">
                <a class="heading-action primary" href="/carrinho">Ver carrinho</a>
                <a class="heading-action secondary" href="/festivais">Festivais</a>
            </div>
        </div>

        <div class="schedule-summary" aria-label="Resumo das sessoes">
            <span><strong>@_sessoes.Count</strong><small>Total</small></span>
            <span><strong>@SessoesAoVivo</strong><small>A decorrer</small></span>
            <span><strong>@SessoesDisponiveis</strong><small>Disponiveis</small></span>
        </div>
    </header>

    <section class="toolbar" aria-label="Filtros de sessoes">
        <label>
            <span>Pesquisa</span>
            <input class="search"
                   placeholder="Filme ou festival"
                   value="@_pesquisa"
                   @oninput="OnPesquisaAlterada" />
        </label>

        <label>
            <span>Estado</span>
            <select class="select" @bind="_estado">
                <option value="">Todos os estados</option>
                <option value="Agendada">Agendada</option>
                <option value="ADecorrer">A decorrer</option>
                <option value="Terminada">Terminada</option>
            </select>
        </label>

        <label class="check">
            <input type="checkbox" @bind="_apenasDisponiveis" />
            Futuras/ativas
        </label>

        <button class="toolbar-clear" type="button" @onclick="LimparFiltros">Limpar</button>
    </section>

    @if (_loading)
    {
        <div class="state-panel" role="status">A carregar sessoes...</div>
    }
    else if (_erro != null)
    {
        <div class="state-panel error">@_erro</div>
    }
    else if (SessoesFiltradas.Count == 0)
    {
        <div class="state-panel">Nao ha sessoes com estes filtros.</div>
    }
    else
    {
        <section class="sessions-grid">
            @foreach (var sessao in SessoesFiltradas)
            {
                <article class="session-row @EstadoCss(EstadoTexto(sessao))">
                    <div class="date-box">
                        <span>@sessao.Inicio.ToLocalTime().ToString("dd")</span>
                        <small>@sessao.Inicio.ToLocalTime().ToString("MMM").ToUpperInvariant()</small>
                    </div>

                    <div class="session-main">
                        <div class="session-titleline">
                            <p>@sessao.Festival</p>
                            <span class="status @EstadoCss(EstadoTexto(sessao))">@EstadoRotulo(sessao)</span>
                        </div>
                        <h2><a href="@($"/sessoes/{sessao.Id}")">@TituloSessao(sessao)</a></h2>

                        <div class="meta-panel">
                            <span><strong>Horario</strong> @sessao.Inicio.ToLocalTime().ToString("dd/MM HH:mm") - @sessao.Fim.ToLocalTime().ToString("HH:mm")</span>
                            <span><strong>Bilhete</strong> @Preco(sessao)</span>
                            <span><strong>Tipo</strong> @sessao.TipoNome</span>
                            <span><strong>Acesso</strong> @AcessoNecessario(sessao)</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(sessao.Observacoes))
                        {
                            <p class="obs">@sessao.Observacoes</p>
                        }
                    </div>

                    <div class="session-actions">
                        <button class="secondary" @onclick="() => AbrirDetalhe(sessao.Id)">Detalhes</button>
                        <button class="primary"
                                disabled="@(_aAtualizar || SessaoTerminada(sessao))"
                                @onclick="() => AdicionarBilhete(sessao.Id)">
                            Comprar
                        </button>
                        <button class="secondary" @onclick="() => AbrirPlayer(sessao.Id)">Player</button>
                        <button class="secondary"
                                disabled="@(!sessao.TemChatAoVivo)"
                                @onclick="() => AbrirChat(sessao.Id)">
                            Chat
                        </button>
                    </div>
                </article>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <div class="feedback @(_feedbackErro ? "error" : "success")">@_feedback</div>
    }
</div>

@code {
    private List<SessaoDTO> _sessoes = new();
    private string? _pesquisa;
    private string _estado = string.Empty;
    private bool _apenasDisponiveis = true;
    private bool _aAtualizar;
    private string? _feedback;
    private bool _feedbackErro;

    private int SessoesAoVivo =>
        _sessoes.Count(s => string.Equals(EstadoTexto(s), "ADecorrer", StringComparison.OrdinalIgnoreCase));

    private int SessoesDisponiveis => _sessoes.Count(s => !SessaoTerminada(s));

    private List<SessaoDTO> SessoesFiltradas =>
        _sessoes
            .Where(s => !_apenasDisponiveis || !SessaoTerminada(s))
            .Where(s => string.IsNullOrWhiteSpace(_estado) || EstadoTexto(s) == _estado)
            .Where(s =>
                string.IsNullOrWhiteSpace(_pesquisa)
                || TituloSessao(s).Contains(_pesquisa, StringComparison.OrdinalIgnoreCase)
                || s.Festival.Contains(_pesquisa, StringComparison.OrdinalIgnoreCase)
            )
            .OrderBy(s => s.Inicio)
            .ToList();

    protected override async Task CarregarDadosAsync()
    {
        _sessoes = await SessaoService.ObterSessoesAsync();
    }

    private void OnPesquisaAlterada(ChangeEventArgs e)
    {
        _pesquisa = e.Value?.ToString();
    }

    private void LimparFiltros()
    {
        _pesquisa = null;
        _estado = string.Empty;
        _apenasDisponiveis = true;
    }

    private async Task AdicionarBilhete(int sessaoId)
    {
        _feedback = null;
        _feedbackErro = false;
        _aAtualizar = true;

        try
        {
            await CarrinhoService.AdicionarBilheteSessaoAsync(sessaoId);
            _feedback = "Bilhete adicionado ao carrinho.";
            _feedbackErro = false;
        }
        catch (Exception ex)
        {
            _feedback = MensagemErroApi.Limpar(ex.Message, "Nao foi possivel adicionar o bilhete.");
            _feedbackErro = true;
        }
        finally
        {
            _aAtualizar = false;
        }
    }

    private static bool SessaoTerminada(SessaoDTO sessao)
    {
        return string.Equals(EstadoTexto(sessao), "Terminada", StringComparison.OrdinalIgnoreCase);
    }

    private static string EstadoTexto(SessaoDTO sessao)
    {
        return string.IsNullOrWhiteSpace(sessao.Estado) ? "Desconhecido" : sessao.Estado;
    }

    private static string EstadoCss(string? estado)
    {
        if (string.Equals(estado, "ADecorrer", StringComparison.OrdinalIgnoreCase))
            return "live";

        if (string.Equals(estado, "Terminada", StringComparison.OrdinalIgnoreCase))
            return "ended";

        return "scheduled";
    }

    private static string TituloSessao(SessaoDTO sessao)
    {
        return string.IsNullOrWhiteSpace(sessao.Filme) ? $"Sessao #{sessao.Id}" : sessao.Filme;
    }

    private static string Preco(SessaoDTO sessao)
    {
        return sessao.PrecoBilhete.HasValue
            ? sessao.PrecoBilhete.Value.ToString("C", new System.Globalization.CultureInfo("pt-PT"))
            : "Bilhete disponivel";
    }

    private static string AcessoNecessario(SessaoDTO sessao)
    {
        return string.IsNullOrWhiteSpace(sessao.AcessoNecessario)
            ? "Bilhete, passe diario ou passe completo"
            : sessao.AcessoNecessario;
    }

    private static string EstadoRotulo(SessaoDTO sessao)
    {
        return EstadoTexto(sessao) switch
        {
            "ADecorrer" => "A decorrer",
            var estado => estado,
        };
    }

    private void AbrirDetalhe(int sessaoId) => Nav.NavigateTo($"/sessoes/{sessaoId}");

    private void AbrirPlayer(int sessaoId) => Nav.NavigateTo($"/visualizar/sessao/{sessaoId}");

    private void AbrirChat(int sessaoId) => Nav.NavigateTo($"/visualizar/sessao/{sessaoId}");
}
