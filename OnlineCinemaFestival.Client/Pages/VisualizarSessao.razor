@page "/visualizar/sessao/{SessaoId:int}"
@attribute [Authorize]
@inject VisualizacaoService VisualizacaoService
@inject NavigationManager Nav
@inject ArmazenamentoToken ArmazenamentoToken
@inject IConfiguration Configuracao

<PageTitle>Visualizar sessao - Online Cinema Festival</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudStack Spacing="3">
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="Voltar">
            Voltar
        </MudButton>

        @if (_aCarregar)
        {
            <MudPaper Elevation="0" Class="pa-6">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Color="Color.Secondary">A carregar player...</MudText>
                </MudStack>
            </MudPaper>
        }
        else if (!string.IsNullOrWhiteSpace(_erro))
        {
            <MudAlert Severity="@_erroSeveridade" Variant="Variant.Filled">
                @_erro
            </MudAlert>
        }
        else if (_conteudoSelecionado != null)
        {
            <MudPaper Elevation="0" Class="pa-0 overflow-hidden">
                <div style="aspect-ratio: 16 / 9; width: 100%; background: #111;">
                    @if (EhVideoDireto(_conteudoSelecionado.UrlVisualizacao))
                    {
                        <video src="@_conteudoSelecionado.UrlVisualizacao"
                               title="@_conteudoSelecionado.Titulo"
                               style="width: 100%; height: 100%;"
                               controls
                               playsinline>
                        </video>
                    }
                    else
                    {
                        <iframe src="@UrlPlayer(_conteudoSelecionado.UrlVisualizacao)"
                                title="@_conteudoSelecionado.Titulo"
                                style="width: 100%; height: 100%; border: 0;"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen>
                        </iframe>
                    }
                </div>
            </MudPaper>

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_visualizacao?.TipoConteudo</MudText>
                    <MudText Typo="Typo.h5">@_conteudoSelecionado.Titulo</MudText>
                </div>
                @if (_visualizacao?.TemChatAoVivo == true && EstadoChat == ChatSessaoEstado.Ativo)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Chat"
                               OnClick="AbrirChatAoVivo">
                        Abrir chat ao vivo
                    </MudButton>
                }
                else if (_visualizacao?.TemChatAoVivo == true)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        @MensagemChat
                    </MudAlert>
                }
            </MudStack>

            @if (_conteudos.Count > 1)
            {
                <MudPaper Elevation="0" Class="pa-3">
                    <MudStack Spacing="1">
                        @foreach (var conteudo in _conteudos)
                        {
                            <MudButton Variant="@(conteudo.FilmeId == _conteudoSelecionado.FilmeId ? Variant.Filled : Variant.Text)"
                                       Color="Color.Primary"
                                       OnClick="() => Selecionar(conteudo)"
                                       StartIcon="@Icons.Material.Filled.PlayArrow">
                                @($"{conteudo.Ordem}. {conteudo.Titulo}")
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public int SessaoId { get; set; }

    private VisualizacaoDTO? _visualizacao;
    private List<ConteudoVisualizacaoDTO> _conteudos = new();
    private ConteudoVisualizacaoDTO? _conteudoSelecionado;
    private bool _aCarregar = true;
    private string? _erro;
    private Severity _erroSeveridade = Severity.Error;

    private ChatSessaoEstado EstadoChat
    {
        get
        {
            if (_visualizacao?.TemChatAoVivo != true)
                return ChatSessaoEstado.Indisponivel;

            var agora = DateTime.UtcNow;

            if (_visualizacao.SessaoInicio.HasValue && agora < _visualizacao.SessaoInicio.Value)
                return ChatSessaoEstado.AindaNaoDisponivel;

            if (_visualizacao.SessaoFim.HasValue && agora > _visualizacao.SessaoFim.Value)
                return ChatSessaoEstado.Terminado;

            return ChatSessaoEstado.Ativo;
        }
    }

    private string MensagemChat =>
        EstadoChat switch
        {
            ChatSessaoEstado.AindaNaoDisponivel => "Chat ainda nao disponivel",
            ChatSessaoEstado.Terminado => "Chat encerrado para esta sessao.",
            _ => "Chat indisponivel.",
        };

    protected override async Task OnParametersSetAsync()
    {
        _aCarregar = true;
        _erro = null;

        try
        {
            _visualizacao = await VisualizacaoService.ObterSessaoAsync(SessaoId);
            _conteudos = _visualizacao.Conteudos.OrderBy(c => c.Ordem).ToList();
            _conteudoSelecionado = _conteudos.FirstOrDefault();
        }
        catch (VisualizacaoApiException ex) when (ex.StatusCode == 403)
        {
            _erro = MensagemErroApi.Limpar(ex.Message, "Sem acesso para abrir esta sessao.");
            _erroSeveridade = Severity.Warning;
        }
        catch (VisualizacaoApiException ex) when (ex.StatusCode == 401)
        {
            _erro = MensagemErroApi.Limpar(ex.Message, "Inicia sessao para continuar.");
            _erroSeveridade = Severity.Warning;
        }
        catch (VisualizacaoApiException ex) when (ex.StatusCode == 404)
        {
            _erro = MensagemErroApi.Limpar(ex.Message, "Sessao nao encontrada.");
            _erroSeveridade = Severity.Error;
        }
        catch (Exception ex)
        {
            _erro = MensagemErroApi.Limpar(ex.Message, "Nao foi possivel abrir esta sessao.");
            _erroSeveridade = Severity.Error;
        }
        finally
        {
            _aCarregar = false;
        }
    }

    private void Selecionar(ConteudoVisualizacaoDTO conteudo)
    {
        _conteudoSelecionado = conteudo;
    }

    private void Voltar() => Nav.NavigateTo("/sessoes");

    private async Task AbrirChatAoVivo()
    {
        var token = await ArmazenamentoToken.ObterAsync();
        var url = $"{ApiBaseUrl()}sessao-player.html?sessaoId={SessaoId}";

        if (!string.IsNullOrWhiteSpace(token))
            url += $"&token={Uri.EscapeDataString(token)}";

        Nav.NavigateTo(url, forceLoad: true);
    }

    private string ApiBaseUrl()
    {
        var apiBaseUrl =
            Configuracao["ApiBaseUrl"]
            ?? throw new InvalidOperationException("ApiBaseUrl nao configurado.");

        return apiBaseUrl.EndsWith('/') ? apiBaseUrl : $"{apiBaseUrl}/";
    }

    private static string UrlPlayer(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        if (url.Contains("/embed/", StringComparison.OrdinalIgnoreCase))
            return url;

        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            if (uri.Host.Contains("youtu.be", StringComparison.OrdinalIgnoreCase))
                return $"https://www.youtube.com/embed/{uri.AbsolutePath.Trim('/')}";

            var videoId = uri.Query
                .TrimStart('?')
                .Split('&', StringSplitOptions.RemoveEmptyEntries)
                .Select(parte => parte.Split('=', 2))
                .FirstOrDefault(partes =>
                    partes.Length == 2 && string.Equals(partes[0], "v", StringComparison.OrdinalIgnoreCase)
                )?[1];

            if (!string.IsNullOrWhiteSpace(videoId))
                return $"https://www.youtube.com/embed/{Uri.UnescapeDataString(videoId)}";
        }

        return url;
    }

    private static bool EhVideoDireto(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return false;

        var valor = url.Split('?', 2)[0];
        return valor.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase)
            || valor.EndsWith(".webm", StringComparison.OrdinalIgnoreCase)
            || valor.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase)
            || valor.StartsWith("/videos/", StringComparison.OrdinalIgnoreCase)
            || valor.StartsWith("videos/", StringComparison.OrdinalIgnoreCase);
    }

    private enum ChatSessaoEstado
    {
        Indisponivel,
        AindaNaoDisponivel,
        Ativo,
        Terminado,
    }
}
