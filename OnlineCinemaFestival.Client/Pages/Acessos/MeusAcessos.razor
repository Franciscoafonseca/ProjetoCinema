@page "/meus-acessos"
@attribute [Authorize]
@inject AcessoService AcessoService
@inject NavigationManager Nav

<PageTitle>Meus acessos - Online Cinema Festival</PageTitle>

<div class="acessos-page">
    <header class="page-heading">
        <div>
            <p class="eyebrow">Biblioteca</p>
            <h1>Meus acessos</h1>
            <p class="lead">Tudo o que tens ativo para ver: bilhetes, passes e alugueres digitais.</p>
        </div>
        <a class="heading-action" href="/sessoes">Ver sessoes</a>
    </header>

    @if (_aCarregar)
    {
        <div class="state-panel">A carregar acessos...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_erro))
    {
        <div class="state-panel error">@_erro</div>
    }
    else if (_acessos.Count == 0)
    {
        <section class="empty-state">
            <h2>Ainda nao tens acessos ativos</h2>
            <p>Compra um bilhete de sessao, um passe de festival ou um aluguer digital para comecar.</p>
            <div class="empty-actions">
                <a href="/sessoes">Ver sessoes</a>
                <a href="/catalogo">Ver catalogo</a>
            </div>
        </section>
    }
    else
    {
        <section class="metrics">
            <article>
                <span>@_acessos.Count(AcessoValido)</span>
                <small>Acessos ativos</small>
            </article>
            <article>
                <span>@_acessos.Count(a => a.SessaoId.HasValue)</span>
                <small>Bilhetes</small>
            </article>
            <article>
                <span>@_acessos.Count(a => a.FilmeId.HasValue && !a.SessaoId.HasValue)</span>
                <small>Filmes digitais</small>
            </article>
        </section>

        <section class="access-grid">
            @foreach (var acesso in _acessos.OrderBy(a => a.FimValidade))
            {
                <article class="access-card">
                    <div class="access-top">
                        <span class="access-type">@acesso.TipoAcessoNome</span>
                        <span class="access-state @(AcessoValido(acesso) ? "active" : "ended")">
                            @EstadoAcesso(acesso)
                        </span>
                    </div>

                    <h2>@TituloAcesso(acesso)</h2>

                    <div class="access-meta">
                        @foreach (var detalhe in DetalhesAcesso(acesso))
                        {
                            <span>@detalhe</span>
                        }
                        <span>Validade: @FormatarPeriodo(acesso.InicioValidade, acesso.FimValidade)</span>
                        @if (acesso.SessaoId.HasValue)
                        {
                            <span>Sessao #@acesso.SessaoId</span>
                        }
                    </div>

                    <div class="access-actions">
                        @if (acesso.SessaoId.HasValue)
                        {
                            <button @onclick="() => AbrirDetalheSessao(acesso.SessaoId.Value)">Ver sessao</button>
                            <button disabled="@(!AcessoValido(acesso))" @onclick="() => AbrirPlayerSessao(acesso.SessaoId.Value)">Entrar no player</button>
                        }
                        else if (acesso.FilmeId.HasValue)
                        {
                            <button @onclick="() => AbrirDetalheFilme(acesso.FilmeId.Value)">Ver filme</button>
                            <button disabled="@(!AcessoValido(acesso))" @onclick="() => AbrirPlayerFilme(acesso.FilmeId.Value)">Entrar no player</button>
                        }
                        else if (acesso.FestivalId.HasValue)
                        {
                            <button @onclick="() => AbrirFestival(acesso.FestivalId.Value)">Ver festival</button>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    private List<AcessoUtilizadorDTO> _acessos = new();
    private bool _aCarregar = true;
    private string? _erro;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _acessos = await AcessoService.ObterMeusAcessosAsync();
        }
        catch (Exception ex)
        {
            _erro = MensagemErroApi.Limpar(ex.Message, "Nao foi possivel carregar os acessos.");
        }
        finally
        {
            _aCarregar = false;
        }
    }

    private void AbrirDetalheSessao(int sessaoId) => Nav.NavigateTo($"/sessoes/{sessaoId}");

    private void AbrirPlayerSessao(int sessaoId) => Nav.NavigateTo($"/visualizar/sessao/{sessaoId}");

    private void AbrirDetalheFilme(int filmeId) => Nav.NavigateTo($"/filmes/{filmeId}");

    private void AbrirPlayerFilme(int filmeId) => Nav.NavigateTo($"/visualizar/filme/{filmeId}");

    private void AbrirFestival(int festivalId) => Nav.NavigateTo($"/festivais/{festivalId}");

    private static string TituloAcesso(AcessoUtilizadorDTO acesso)
    {
        if (!string.IsNullOrWhiteSpace(acesso.TituloFilme))
            return acesso.TituloFilme;

        if (!string.IsNullOrWhiteSpace(acesso.NomeFestival))
            return acesso.NomeFestival;

        return string.IsNullOrWhiteSpace(acesso.NomeAcesso)
            ? $"Acesso #{acesso.AcessoId}"
            : acesso.NomeAcesso;
    }

    private static IEnumerable<string> DetalhesAcesso(AcessoUtilizadorDTO acesso)
    {
        if (!string.IsNullOrWhiteSpace(acesso.NomeAcesso))
            yield return acesso.NomeAcesso;

        if (!string.IsNullOrWhiteSpace(acesso.NomeFestival))
            yield return acesso.NomeFestival;

        if (acesso.InicioSessao.HasValue)
            yield return $"Sessao: {acesso.InicioSessao.Value.ToLocalTime():dd/MM/yyyy HH:mm}";

        if (acesso.DataAcesso.HasValue)
            yield return $"Dia: {acesso.DataAcesso.Value.ToLocalTime():dd/MM/yyyy}";

        if (acesso.DuracaoHoras.HasValue)
            yield return $"{acesso.DuracaoHoras.Value} horas";
    }

    private static bool AcessoValido(AcessoUtilizadorDTO acesso)
    {
        return acesso.PodeVisualizarAgora;
    }

    private static string EstadoAcesso(AcessoUtilizadorDTO acesso)
    {
        return string.IsNullOrWhiteSpace(acesso.EstadoAcesso)
            ? (acesso.PodeVisualizarAgora ? "Ativo" : "Indisponivel")
            : acesso.EstadoAcesso;
    }

    private static string FormatarPeriodo(DateTime inicio, DateTime fim)
    {
        return $"{inicio.ToLocalTime():dd/MM/yyyy HH:mm} - {fim.ToLocalTime():dd/MM/yyyy HH:mm}";
    }
}
