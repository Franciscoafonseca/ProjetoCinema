@page "/rewards"
@attribute [Authorize]
@inject RewardsService RewardsService

<PageTitle>Rewards - Online Cinema Festival</PageTitle>

<main class="cinema-page rewards-page">
    <section class="cinema-shell rewards-shell">
        <header class="cinema-page-head rewards-header">
            <div>
                <span class="cinema-kicker">Rewards</span>
                <h1>Os teus pontos</h1>
                <p>Historico de pontos ganhos por acoes reais na plataforma.</p>
            </div>
            <div class="points-total">
                <span>Total</span>
                <strong>@_saldo</strong>
            </div>
        </header>

        @if (_loading)
        {
            <div class="cinema-state">
                <div class="spinner"></div>
                <p>A carregar rewards...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_erro))
        {
            <div class="cinema-state error">
                <p>@_erro</p>
                <button class="cinema-btn secondary" @onclick="CarregarRewardsAsync">Tentar novamente</button>
            </div>
        }
        else
        {
            <section class="cinema-panel rewards-summary">
                <div>
                    <span class="summary-label">Saldo disponivel</span>
                    <strong>@_saldo pontos</strong>
                </div>
                <div>
                    <span class="summary-label">Acoes registadas</span>
                    <strong>@_historico.Count</strong>
                </div>
            </section>

            <section class="cinema-panel">
                <div class="cinema-section-head compact">
                    <div>
                        <span class="cinema-kicker">Historico</span>
                        <h2>Movimentos de pontos</h2>
                    </div>
                </div>

                @if (_historico.Count == 0)
                {
                    <div class="cinema-state slim">Ainda nao ha pontos registados.</div>
                }
                else
                {
                    <div class="reward-history">
                        @foreach (var transacao in _historico.OrderByDescending(t => t.Data))
                        {
                            <article class="reward-row">
                                <div>
                                    <strong>@transacao.Motivo</strong>
                                    <span>@transacao.Data.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <b>+@transacao.Pontos</b>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </section>
</main>

@code {
    private int _saldo;
    private bool _loading = true;
    private string? _erro;
    private List<RewardTransacaoDto> _historico = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarRewardsAsync();
    }

    private async Task CarregarRewardsAsync()
    {
        _loading = true;
        _erro = null;

        try
        {
            _saldo = await RewardsService.GetSaldoAsync();
            _historico = await RewardsService.GetHistoricoAsync();
        }
        catch (Exception ex)
        {
            _erro = MensagemErroApi.Limpar(
                ex.Message,
                "Nao foi possivel carregar os teus rewards."
            );
            _historico.Clear();
            _saldo = 0;
        }
        finally
        {
            _loading = false;
        }
    }
}
