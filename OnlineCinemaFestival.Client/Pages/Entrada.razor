@page "/login"
@implements IAsyncDisposable
@inject IAutenticacaoService AutenticacaoService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Entrar - Online Cinema Festival</PageTitle>

<main class="auth-page">
    <section class="auth-shell">
        <div class="auth-copy">
            <span class="auth-kicker">Online Cinema Festival</span>
            <h1>Entra no festival.</h1>
            <p>Retoma listas, bilhetes, sessoes e comunidades com a mesma experiencia visual da plataforma.</p>
        </div>

        <div class="auth-card">
            <div class="auth-card-head">
                <span class="auth-logo">
                    <img src="images/logos/cinehub-icon-cor.png" alt="" />
                </span>
                <div>
                    <h2>Entrar</h2>
                    <p>Acede a tua conta.</p>
                </div>
            </div>

            <div class="auth-social-grid">
                <button type="button" class="auth-social" disabled="@_aSubmeter" @onclick='() => EntrarExterno("Google")'>
                    <span class="auth-provider-logo google-logo">G</span>
                    <strong>Google</strong>
                    <small>@EstadoProvider("Google")</small>
                </button>
                <button type="button" class="auth-social" disabled="@_aSubmeter" @onclick='() => EntrarExterno("Apple")'>
                    <span class="auth-provider-logo apple-logo">Apple</span>
                    <strong>Apple</strong>
                    <small>@EstadoProvider("Apple")</small>
                </button>
            </div>

            <div class="auth-separator"><span>ou</span></div>

            <EditForm Model="_modelo" OnValidSubmit="Entrar">
                <DataAnnotationsValidator />
                <ValidationSummary class="auth-validation-summary" />

                <div class="auth-campo">
                    <label for="email">Email</label>
                    <InputText id="email" class="auth-input" @bind-Value="_modelo.Email" type="email" autocomplete="email" />
                    <ValidationMessage For="@(() => _modelo.Email)" class="auth-erro-campo" />
                </div>

                <div class="auth-campo">
                    <label for="password">Palavra-passe</label>
                    <InputText id="password" class="auth-input" @bind-Value="_modelo.Password" type="password" autocomplete="current-password" />
                    <ValidationMessage For="@(() => _modelo.Password)" class="auth-erro-campo" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_erro))
                {
                    <p class="auth-erro-geral" role="alert">@_erro</p>
                }

                <button type="submit" class="btn-auth" disabled="@_aSubmeter">
                    @(_aSubmeter ? "A entrar..." : "Entrar")
                </button>
            </EditForm>

            <p class="auth-rodape">
                Ainda nao tens conta? <a href="/registo">Regista-te</a>
            </p>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly PedidoLoginDTO _modelo = new();
    private List<ProvedorAutenticacaoExternaDTO> _provedoresExternos = new();
    private IJSObjectReference? _externalAuthModule;
    private string? _erro;
    private bool _aSubmeter;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _provedoresExternos = await AutenticacaoService.ObterProvedoresExternosAsync();
        }
        catch
        {
            _provedoresExternos = new();
        }
    }

    private async Task Entrar()
    {
        _erro = null;
        _aSubmeter = true;

        try
        {
            await AutenticacaoService.EntrarAsync(_modelo);
            var destino = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;
            Nav.NavigateTo(destino);
        }
        catch (Exception ex)
        {
            _erro = MensagemErroApi.Limpar(ex.Message, "Nao foi possivel iniciar sessao.");
        }
        finally
        {
            _aSubmeter = false;
        }
    }

    private async Task EntrarExterno(string provider)
    {
        _erro = null;
        _aSubmeter = true;

        try
        {
            var configuracao = _provedoresExternos.FirstOrDefault(p =>
                p.Provider.Equals(provider, StringComparison.OrdinalIgnoreCase)
            );

            if (configuracao == null || !configuracao.Configurado)
                throw new InvalidOperationException($"{provider} ainda nao esta configurado no servidor.");

            _externalAuthModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/external-auth.js"
            );

            var pedido = await _externalAuthModule.InvokeAsync<PedidoAutenticacaoExternaDTO>(
                "signIn",
                provider,
                configuracao.ClientId,
                ReturnUrl ?? string.Empty
            );

            await AutenticacaoService.EntrarComExternoAsync(pedido);
            Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
        }
        catch (Exception ex)
        {
            _erro = MensagemErroApi.Limpar(ex.Message, "Nao foi possivel autenticar com o provider externo.");
        }
        finally
        {
            _aSubmeter = false;
        }
    }

    private string EstadoProvider(string provider)
    {
        var configurado = _provedoresExternos.FirstOrDefault(p =>
            p.Provider.Equals(provider, StringComparison.OrdinalIgnoreCase)
        )?.Configurado;

        return configurado == true ? "oauth" : "configurar";
    }

    public async ValueTask DisposeAsync()
    {
        if (_externalAuthModule is not null)
            await _externalAuthModule.DisposeAsync();
    }
}
