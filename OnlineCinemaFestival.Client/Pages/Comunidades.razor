@page "/comunidades"
@attribute [Authorize]
@inject ComunidadeService ComunidadeService
@inject ComentarioService ComentarioService

<PageTitle>Comunidades - Online Cinema Festival</PageTitle>

<main class="cinema-page comunidades-page">
    <section class="cinema-shell">
        <header class="comunidades-hero cinema-panel">
            <div>
                <span class="cinema-kicker">Social</span>
                <h1>Comunidades</h1>
                <p>Segue grupos de cinefilos, entra por convite e comenta com membros da comunidade.</p>
            </div>
            <button class="cinema-btn primary" @onclick="CarregarTudoAsync" disabled="@_aCarregar">
                @(_aCarregar ? "A atualizar..." : "Atualizar")
            </button>
        </header>

        @if (!string.IsNullOrWhiteSpace(_erroGeral))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_erroGeral</MudAlert>
        }

        <section class="community-workspace">
            <div class="community-main">
                <section class="cinema-panel">
                    <div class="cinema-section-head compact">
                        <div>
                            <span class="cinema-kicker">Minhas</span>
                            <h2>Minhas comunidades</h2>
                        </div>
                    </div>

                    @if (_aCarregar)
                    {
                        <div class="cinema-state slim">A carregar comunidades...</div>
                    }
                    else if (_minhas.Count == 0)
                    {
                        <div class="cinema-state slim">Ainda nao pertences a nenhuma comunidade.</div>
                    }
                    else
                    {
                        <div class="community-grid">
                            @foreach (var comunidade in _minhas)
                            {
                                @CardComunidade(comunidade, true)
                            }
                        </div>
                    }
                </section>

                <section class="cinema-panel">
                    <div class="cinema-section-head compact">
                        <div>
                            <span class="cinema-kicker">Publicas</span>
                            <h2>Comunidades publicas</h2>
                        </div>
                    </div>

                    @if (_aCarregar)
                    {
                        <div class="cinema-state slim">A carregar comunidades publicas...</div>
                    }
                    else if (_publicas.Count == 0)
                    {
                        <div class="cinema-state slim">Nao ha comunidades publicas novas para aderir.</div>
                    }
                    else
                    {
                        <div class="community-grid">
                            @foreach (var comunidade in _publicas)
                            {
                                @CardComunidade(comunidade, false)
                            }
                        </div>
                    }
                </section>
            </div>

            <aside class="community-side">
                <section class="cinema-panel">
                    <div class="cinema-section-head compact">
                        <div>
                            <span class="cinema-kicker">Criar</span>
                            <h2>Nova comunidade</h2>
                        </div>
                    </div>

                    <EditForm Model="_novaComunidade" OnValidSubmit="CriarComunidadeAsync">
                        <DataAnnotationsValidator />
                        <div class="community-form">
                            <InputText class="text-input" @bind-Value="_novaComunidade.Name" placeholder="Nome" />
                            <ValidationMessage For="@(() => _novaComunidade.Name)" />
                            <InputTextArea class="text-area" @bind-Value="_novaComunidade.Description" placeholder="Descricao" />
                            <ValidationMessage For="@(() => _novaComunidade.Description)" />
                            <InputText class="text-input" @bind-Value="_novaComunidade.ImageUrl" placeholder="URL da imagem opcional" />
                            <label class="check-row">
                                <InputCheckbox @bind-Value="_novaComunidade.IsPublic" />
                                <span>Comunidade publica</span>
                            </label>
                            <button class="cinema-btn primary" type="submit" disabled="@_aCriar">
                                @(_aCriar ? "A criar..." : "Criar comunidade")
                            </button>
                        </div>
                    </EditForm>

                    @if (!string.IsNullOrWhiteSpace(_mensagemCriar))
                    {
                        <MudAlert Severity="@_severidadeCriar" Variant="Variant.Filled">@_mensagemCriar</MudAlert>
                    }
                </section>

                <section class="cinema-panel">
                    <div class="cinema-section-head compact">
                        <div>
                            <span class="cinema-kicker">Convite</span>
                            <h2>Aderir por convite</h2>
                        </div>
                    </div>
                    <div class="community-form">
                        <InputText class="text-input" @bind-Value="_codigoConvite" placeholder="Codigo de convite" />
                        <button class="cinema-btn secondary" @onclick="ProcurarConviteAsync" disabled="@_aConvite">
                            @(_aConvite ? "A procurar..." : "Ver convite")
                        </button>
                        <button class="cinema-btn primary" @onclick="AderirPorConviteAsync" disabled="@(_aConvite || string.IsNullOrWhiteSpace(_codigoConvite))">
                            Aderir
                        </button>
                    </div>

                    @if (_conviteEncontrado != null)
                    {
                        <div class="invite-preview">
                            <strong>@_conviteEncontrado.Name</strong>
                            <span>@Resumo(_conviteEncontrado.Description)</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_mensagemConvite))
                    {
                        <MudAlert Severity="@_severidadeConvite" Variant="Variant.Filled">@_mensagemConvite</MudAlert>
                    }
                </section>
            </aside>
        </section>

        @if (_selecionada != null)
        {
            <section class="cinema-panel community-detail">
                <div class="detail-head">
                    <div>
                        <span class="cinema-kicker">Detalhe</span>
                        <h2>@_selecionada.Name</h2>
                        <p>@Resumo(_selecionada.Description)</p>
                    </div>
                    <div class="detail-meta">
                        <span>@_selecionada.MembersCount membros</span>
                        <span>@(_selecionada.IsPublic ? "Publica" : "Privada")</span>
                        @if (!string.IsNullOrWhiteSpace(_selecionada.CodigoConvite))
                        {
                            <span>Convite @_selecionada.CodigoConvite</span>
                        }
                    </div>
                </div>

                @if (_aCarregarComentarios)
                {
                    <div class="cinema-state slim">A carregar comentarios...</div>
                }
                else if (_comentarios.Count == 0)
                {
                    <div class="cinema-state slim">Ainda nao ha comentarios nesta comunidade.</div>
                }
                else
                {
                    <div class="comment-list">
                        @foreach (var comentario in _comentarios.OrderByDescending(c => c.CriadoEm))
                        {
                            <article class="comment-card">
                                <div class="comment-avatar">@Inicial(comentario.NomeUsuario)</div>
                                <div>
                                    <strong>@NomeUtilizador(comentario.NomeUsuario)</strong>
                                    <span>@comentario.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    <p>@comentario.Texto</p>
                                </div>
                            </article>
                        }
                    </div>
                }

                <EditForm Model="_novoComentario" OnValidSubmit="PublicarComentarioAsync">
                    <DataAnnotationsValidator />
                    <div class="comment-form">
                        <InputTextArea class="text-area" @bind-Value="_novoComentario.Texto" placeholder="Escreve um comentario" />
                        <ValidationMessage For="@(() => _novoComentario.Texto)" />
                        <button class="cinema-btn primary" type="submit" disabled="@_aComentar">
                            @(_aComentar ? "A publicar..." : "Publicar comentario")
                        </button>
                    </div>
                </EditForm>

                @if (!string.IsNullOrWhiteSpace(_mensagemComentario))
                {
                    <MudAlert Severity="@_severidadeComentario" Variant="Variant.Filled">@_mensagemComentario</MudAlert>
                }
            </section>
        }
    </section>
</main>

@code {
    private List<ComunidadeDTO> _minhas = new();
    private List<ComunidadeDTO> _publicas = new();
    private List<ComentarioDTO> _comentarios = new();
    private ComunidadeDTO? _selecionada;
    private ComunidadeDTO? _conviteEncontrado;
    private ComunidadeCreateDTO _novaComunidade = new();
    private ComentarioCreateDTO _novoComentario = new();
    private bool _aCarregar = true;
    private bool _aCriar;
    private bool _aConvite;
    private bool _aAderir;
    private bool _aCarregarComentarios;
    private bool _aComentar;
    private string? _erroGeral;
    private string? _mensagemCriar;
    private string? _mensagemConvite;
    private string? _mensagemComentario;
    private Severity _severidadeCriar = Severity.Info;
    private Severity _severidadeConvite = Severity.Info;
    private Severity _severidadeComentario = Severity.Info;
    private string _codigoConvite = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarTudoAsync();
    }

    private async Task CarregarTudoAsync()
    {
        _aCarregar = true;
        _erroGeral = null;

        try
        {
            _minhas = await ComunidadeService.ObterMinhasAsync();
            _publicas = await ComunidadeService.ObterPublicasAsync();
        }
        catch (Exception ex)
        {
            _erroGeral = ex.Message;
        }
        finally
        {
            _aCarregar = false;
        }
    }

    private async Task CriarComunidadeAsync()
    {
        _aCriar = true;
        _mensagemCriar = null;

        try
        {
            _novaComunidade.Name = _novaComunidade.Name.Trim();
            _novaComunidade.Description = _novaComunidade.Description.Trim();
            var comunidade = await ComunidadeService.CriarAsync(_novaComunidade);
            _minhas.Insert(0, comunidade);
            _novaComunidade = new ComunidadeCreateDTO();
            _mensagemCriar = "Comunidade criada.";
            _severidadeCriar = Severity.Success;
            await SelecionarComunidadeAsync(comunidade);
        }
        catch (Exception ex)
        {
            _mensagemCriar = ex.Message;
            _severidadeCriar = Severity.Error;
        }
        finally
        {
            _aCriar = false;
        }
    }

    private async Task ProcurarConviteAsync()
    {
        _aConvite = true;
        _mensagemConvite = null;
        _conviteEncontrado = null;

        try
        {
            ValidarCodigoConvite();
            _conviteEncontrado = await ComunidadeService.ObterPorConviteAsync(_codigoConvite);
            _mensagemConvite = "Convite encontrado.";
            _severidadeConvite = Severity.Success;
        }
        catch (Exception ex)
        {
            _mensagemConvite = ex.Message;
            _severidadeConvite = Severity.Error;
        }
        finally
        {
            _aConvite = false;
        }
    }

    private async Task AderirPorConviteAsync()
    {
        _aConvite = true;
        _mensagemConvite = null;

        try
        {
            ValidarCodigoConvite();
            await ComunidadeService.AderirPorConviteAsync(_codigoConvite);
            _mensagemConvite = "Entraste na comunidade.";
            _severidadeConvite = Severity.Success;
            _codigoConvite = string.Empty;
            _conviteEncontrado = null;
            await CarregarTudoAsync();
        }
        catch (Exception ex)
        {
            _mensagemConvite = ex.Message;
            _severidadeConvite = Severity.Error;
        }
        finally
        {
            _aConvite = false;
        }
    }

    private async Task AderirAsync(ComunidadeDTO comunidade)
    {
        _aAderir = true;
        _erroGeral = null;

        try
        {
            await ComunidadeService.AderirAsync(comunidade.Id);
            _publicas.Remove(comunidade);
            comunidade.MembersCount++;
            _minhas.Insert(0, comunidade);
            await SelecionarComunidadeAsync(comunidade);
        }
        catch (Exception ex)
        {
            _erroGeral = ex.Message;
        }
        finally
        {
            _aAderir = false;
        }
    }

    private async Task SelecionarComunidadeAsync(ComunidadeDTO comunidade)
    {
        _selecionada = comunidade;
        _mensagemComentario = null;
        _aCarregarComentarios = true;

        try
        {
            _comentarios = await ComentarioService.ObterDaComunidadeAsync(comunidade.Id);
        }
        catch (Exception ex)
        {
            _mensagemComentario = ex.Message;
            _severidadeComentario = Severity.Error;
        }
        finally
        {
            _aCarregarComentarios = false;
        }
    }

    private async Task PublicarComentarioAsync()
    {
        if (_selecionada == null)
            return;

        _aComentar = true;
        _mensagemComentario = null;

        try
        {
            var comentario = await ComentarioService.CriarNaComunidadeAsync(
                _selecionada.Id,
                _novoComentario
            );
            _comentarios.Insert(0, comentario);
            _novoComentario = new ComentarioCreateDTO();
            _mensagemComentario = "Comentario publicado.";
            _severidadeComentario = Severity.Success;
        }
        catch (Exception ex)
        {
            _mensagemComentario = ex.Message;
            _severidadeComentario = Severity.Error;
        }
        finally
        {
            _aComentar = false;
        }
    }

    private void ValidarCodigoConvite()
    {
        _codigoConvite = _codigoConvite.Trim();

        if (string.IsNullOrWhiteSpace(_codigoConvite))
            throw new InvalidOperationException("Escreve o codigo de convite.");
    }

    private RenderFragment CardComunidade(ComunidadeDTO comunidade, bool membro) => @<article class="community-card">
        <div class="community-cover">
            @if (string.IsNullOrWhiteSpace(comunidade.ImageUrl))
            {
                <span>@Inicial(comunidade.Name)</span>
            }
            else
            {
                <img src="@comunidade.ImageUrl" alt="@comunidade.Name" />
            }
        </div>
        <div class="community-content">
            <div>
                <strong>@comunidade.Name</strong>
                <p>@Resumo(comunidade.Description)</p>
            </div>
            <div class="community-meta">
                <span>@comunidade.MembersCount membros</span>
                <span>@comunidade.ComentariosCount comentarios</span>
            </div>
            <div class="community-actions">
                <button class="cinema-btn secondary" @onclick="() => SelecionarComunidadeAsync(comunidade)">Ver detalhes</button>
                @if (!membro)
                {
                    <button class="cinema-btn primary" disabled="@_aAderir" @onclick="() => AderirAsync(comunidade)">Aderir</button>
                }
            </div>
        </div>
    </article>;

    private static string Resumo(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return "Sem descricao.";

        return texto.Length <= 160 ? texto : texto[..160] + "...";
    }

    private static string NomeUtilizador(string? nome)
    {
        return string.IsNullOrWhiteSpace(nome) ? "Utilizador" : nome;
    }

    private static string Inicial(string? valor)
    {
        var texto = valor?.Trim();
        return string.IsNullOrWhiteSpace(texto)
            ? "?"
            : char.ToUpperInvariant(texto[0]).ToString();
    }
}
