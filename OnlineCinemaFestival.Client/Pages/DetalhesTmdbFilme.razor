@page "/tmdb/filmes/{TmdbId:int}"
@inherits FilmePageBase
@inject TmdbService TmdbService
@inject IImportacaoFilmeService ImportacaoFilmeService
@inject NavigationManager Nav

<PageTitle>TMDB - Online Cinema Festival</PageTitle>

<main class="cinema-page detalhes-page">
    <section class="cinema-shell">
        @if (_loading)
        {
            <div class="cinema-state">A carregar detalhe TMDB...</div>
        }
        else if (_erro != null)
        {
            <div class="cinema-state error">@_erro</div>
        }
        else if (_filme == null)
        {
            <div class="cinema-state">Filme TMDB nao encontrado.</div>
        }
        else
        {
            <button class="back-link" @onclick="VoltarCatalogo">Voltar ao catalogo</button>

            <section class="detalhes-hero cinema-panel">
                <div class="detalhes-poster">
                    <img src="@ImagemFilme(_filme)" alt="@_filme.Titulo" />
                </div>
                <div class="detalhes-info">
                    <span class="cinema-kicker">Detalhe externo TMDB</span>
                    <h1>@_filme.Titulo</h1>
                    <div class="chip-row">
                        <span>@AnoFilme(_filme)</span>
                        <span>@GeneroFilme(_filme)</span>
                        <span>TMDB @(_filme.AvaliacaoTmdb?.ToString("0.0") ?? "N/D")/10</span>
                    </div>
                    <p class="sinopse">@(_filme.Sinopse ?? "Sem sinopse disponivel.")</p>
                    <dl class="facts-grid">
                        <div><dt>Realizador</dt><dd>@Valor(_filme.RealizadorDetalhe?.Nome ?? _filme.Realizador)</dd></div>
                        <div><dt>Atores</dt><dd>@AtoresResumo(_filme)</dd></div>
                        <div><dt>Duracao</dt><dd>@(_filme.DuracaoMinutos.HasValue ? $"{_filme.DuracaoMinutos} min" : "N/D")</dd></div>
                        <div><dt>Trailer</dt><dd>@(string.IsNullOrWhiteSpace(_filme.VideoKey) ? "N/D" : _filme.VideoProvider)</dd></div>
                    </dl>

                    <AuthorizeView Roles="@NomesPapeis.Administrador">
                        <Authorized>
                            <button class="cinema-btn primary" disabled="@_aImportar" @onclick="Importar">
                                @(_aImportar ? "A adicionar..." : "Adicionar ao catalogo")
                            </button>
                        </Authorized>
                        <NotAuthorized>
                            <div class="admin-only-note">Apenas administradores podem adicionar filmes TMDB ao catalogo.</div>
                        </NotAuthorized>
                    </AuthorizeView>
                    @if (!string.IsNullOrWhiteSpace(_mensagem))
                    {
                        <MudAlert Severity="@_mensagemSeveridade" Variant="Variant.Filled">@_mensagem</MudAlert>
                    }
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(TrailerEmbedUrl))
            {
                <section class="cinema-panel trailer-section">
                    <div class="cinema-section-head compact">
                        <div>
                            <span class="cinema-kicker">Trailer</span>
                            <h2>Trailer TMDB/YouTube</h2>
                        </div>
                    </div>
                    <div class="trailer-wrapper">
                        <iframe src="@TrailerEmbedUrl" title="Trailer de @_filme.Titulo" allowfullscreen></iframe>
                    </div>
                </section>
            }

            @if (_filme.AtoresDetalhes.Count > 0)
            {
                <section class="cinema-panel pessoas-section">
                    <div class="cinema-section-head compact">
                        <div>
                            <span class="cinema-kicker">Creditos</span>
                            <h2>Elenco principal</h2>
                        </div>
                    </div>
                    <div class="pessoas-grid">
                        @foreach (var ator in _filme.AtoresDetalhes.Take(10))
                        {
                            <article class="pessoa-card">
                                <div class="pessoa-avatar">
                                    @if (string.IsNullOrWhiteSpace(ator.ImagemUrl))
                                    {
                                        <span>@IniciaisPessoa(ator.Nome)</span>
                                    }
                                    else
                                    {
                                        <img src="@ator.ImagemUrl" alt="@ator.Nome" />
                                    }
                                </div>
                                <div>
                                    <strong>@ator.Nome</strong>
                                    <span>@(string.IsNullOrWhiteSpace(ator.Personagem) ? "Ator" : ator.Personagem)</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        }
    </section>
</main>

@code {
    [Parameter] public int TmdbId { get; set; }

    private FilmeDTO? _filme;
    private bool _aImportar;
    private string? _mensagem;
    private Severity _mensagemSeveridade = Severity.Info;
    private string? TrailerEmbedUrl => ConverterParaEmbed(_filme?.TrailerUrl ?? _filme?.VideoUrl);

    protected override async Task CarregarDadosAsync()
    {
        _filme = await TmdbService.ObterFilmeAsync(TmdbId);
    }

    private async Task Importar()
    {
        _aImportar = true;
        _mensagem = null;
        try
        {
            var importado = await ImportacaoFilmeService.ImportarTmdbAsync(TmdbId);
            Nav.NavigateTo($"/filmes/{importado.Id}");
        }
        catch (Exception ex)
        {
            _mensagemSeveridade = Severity.Error;
            _mensagem = ex.Message;
        }
        finally
        {
            _aImportar = false;
        }
    }

    private void VoltarCatalogo() => Nav.NavigateTo("/catalogo");

    private static string ImagemFilme(FilmeDTO filme) =>
        string.IsNullOrWhiteSpace(filme.CapaUrl) ? "https://placehold.co/500x750/111827/ffffff?text=TMDB" : filme.CapaUrl;

    private static string AnoFilme(FilmeDTO filme) => filme.DataLancamento == default ? "N/D" : filme.DataLancamento.Year.ToString();

    private static string GeneroFilme(FilmeDTO filme) => filme.Generos.Count > 0 ? string.Join(", ", filme.Generos) : filme.Genero ?? "Cinema";

    private static string Valor(string? valor) => string.IsNullOrWhiteSpace(valor) ? "N/D" : valor;

    private static string AtoresResumo(FilmeDTO filme) =>
        filme.AtoresDetalhes.Count > 0 ? string.Join(", ", filme.AtoresDetalhes.Take(5).Select(a => a.Nome))
        : filme.Atores.Count > 0 ? string.Join(", ", filme.Atores.Take(5)) : "N/D";

    private static string IniciaisPessoa(string nome)
    {
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return partes.Length == 0 ? "?" : string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private static string? ConverterParaEmbed(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return null;

        if (url.Contains("/embed/", StringComparison.OrdinalIgnoreCase))
            return url;

        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            if (uri.Host.Contains("youtu.be", StringComparison.OrdinalIgnoreCase))
                return $"https://www.youtube.com/embed/{uri.AbsolutePath.Trim('/')}";

            var videoId = uri.Query.TrimStart('?')
                .Split('&', StringSplitOptions.RemoveEmptyEntries)
                .Select(parte => parte.Split('=', 2))
                .FirstOrDefault(partes => partes.Length == 2 && string.Equals(partes[0], "v", StringComparison.OrdinalIgnoreCase))?[1];

            if (!string.IsNullOrWhiteSpace(videoId))
                return $"https://www.youtube.com/embed/{Uri.UnescapeDataString(videoId)}";
        }

        return url;
    }
}
