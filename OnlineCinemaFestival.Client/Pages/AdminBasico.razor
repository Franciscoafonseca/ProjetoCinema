@page "/admin"
@attribute [Authorize(Roles = "Administrador")]
@inject FilmeService FilmeService
@inject TmdbService TmdbService
@inject FestivalService FestivalService
@inject SessaoService SessaoService
@inject AcessoService AcessoService
@inject PremioFestivalService PremioFestivalService

<PageTitle>Admin - Online Cinema Festival</PageTitle>

<main class="cinema-page admin-page">
    <section class="cinema-shell">
        <header class="cinema-page-head">
            <div>
                <span class="cinema-kicker">Admin basico</span>
                <h1>Painel operacional</h1>
                <p>
                    Visao rapida do catalogo, festivais, sessoes e acessos para acompanhar o estado
                    principal da plataforma.
                </p>
            </div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Movie"
                       Href="/catalogo">
                Catalogo
            </MudButton>
        </header>

        @if (_aCarregar)
        {
            <div class="cinema-state">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <p>A carregar painel...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_erro))
        {
            <div class="cinema-state error">@_erro</div>
        }
        else
        {
            <section class="admin-metricas">
                @foreach (var metrica in _metricas)
                {
                    <MudCard Elevation="0" Class="cinema-panel admin-metrica">
                        <MudCardContent>
                            <MudIcon Icon="@metrica.Icone" Color="@metrica.Cor" Size="Size.Large" />
                            <strong>@metrica.Valor</strong>
                            <span>@metrica.Rotulo</span>
                        </MudCardContent>
                    </MudCard>
                }
            </section>

            <section class="admin-acoes">
                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">TMDB</span>
                        <h2>Importar/adicionar filme</h2>
                        <div class="admin-lista">
                            <input placeholder="Pesquisar no TMDB" @bind="_pesquisaTmdb" @bind:event="oninput" />
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_aAtualizarOperacao"
                                       OnClick="PesquisarTmdb">
                                Pesquisar
                            </MudButton>
                            @foreach (var filme in _resultadosTmdb.Take(5))
                            {
                                <div>
                                    <strong>@filme.Titulo</strong>
                                    <span>TMDB @filme.TmdbId</span>
                                    <MudButton Size="Size.Small"
                                               Disabled="@_aAtualizarOperacao"
                                               OnClick="() => ImportarTmdb(filme.TmdbId)">
                                        Adicionar ao catalogo
                                    </MudButton>
                                </div>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">Festival</span>
                        <h2>Criar festival</h2>
                        <div class="admin-lista">
                            <input placeholder="Nome" @bind="_novoFestival.Name" />
                            <textarea placeholder="Descricao curta" @bind="_novoFestival.Description"></textarea>
                            <input type="date"
                                   @bind-value="_novoFestival.StartDate"
                                   @bind-value:format="yyyy-MM-dd" />
                            <input type="date"
                                   @bind-value="_novoFestival.EndDate"
                                   @bind-value:format="yyyy-MM-dd" />
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@_aAtualizarOperacao"
                                       OnClick="CriarFestival">
                                Criar festival
                            </MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">Catalogo</span>
                        <h2>Adicionar filme ao festival</h2>
                        <div class="admin-lista">
                            <select @bind="_festivalOperacaoId">
                                <option value="0">Selecionar festival</option>
                                @foreach (var festival in _festivais)
                                {
                                    <option value="@festival.Id">@festival.Name</option>
                                }
                            </select>
                            <select @bind="_associacao.FilmeId">
                                <option value="0">Selecionar filme</option>
                                @foreach (var filme in _filmes)
                                {
                                    <option value="@filme.Id">@filme.Titulo</option>
                                }
                            </select>
                            <input placeholder="Secao" @bind="_associacao.Secao" />
                            <input placeholder="Categoria" @bind="_associacao.Categoria" />
                            <label>
                                <input type="checkbox" @bind="_associacao.ElegivelPremiosPublico" />
                                Elegivel para premios do publico
                            </label>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(_festivalOperacaoId == 0 || _associacao.FilmeId == 0 || _aAtualizarOperacao)"
                                       OnClick="AdicionarFilmeAoFestival">
                                Adicionar filme
                            </MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>
            </section>

            <section class="admin-acoes">
                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">Sessao</span>
                        <h2>Criar sessao</h2>
                        <div class="admin-lista">
                            <select @bind="_novaSessao.FestivalId">
                                <option value="0">Selecionar festival</option>
                                @foreach (var festival in _festivais)
                                {
                                    <option value="@festival.Id">@festival.Name</option>
                                }
                            </select>
                            <select @bind="_novaSessao.FilmeId">
                                <option value="0">Selecionar filme</option>
                                @foreach (var filme in _filmes)
                                {
                                    <option value="@filme.Id">@filme.Titulo</option>
                                }
                            </select>
                            <select @bind="_novaSessao.Tipo">
                                <option value="2">HorarioFixo</option>
                                <option value="1">Estreia</option>
                                <option value="3">JanelaAcesso</option>
                            </select>
                            <input type="datetime-local"
                                   @bind-value="_novaSessao.Inicio"
                                   @bind-value:format="yyyy-MM-ddTHH:mm" />
                            <input type="datetime-local"
                                   @bind-value="_novaSessao.Fim"
                                   @bind-value:format="yyyy-MM-ddTHH:mm" />
                            <label>
                                <input type="checkbox" @bind="_novaSessao.TemChatAoVivo" />
                                Chat ao vivo
                            </label>
                            <textarea placeholder="Observacoes" @bind="_novaSessao.Observacoes"></textarea>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(_novaSessao.FestivalId == 0 || _novaSessao.FilmeId == 0 || _aAtualizarOperacao)"
                                       OnClick="CriarSessao">
                                Criar sessao
                            </MudButton>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_mensagemOperacao))
                        {
                            <p class="admin-muted">@_mensagemOperacao</p>
                        }
                    </MudCardContent>
                </MudCard>
            </section>

            <section class="admin-acoes">
                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">Gestao</span>
                        <h2>Atalhos</h2>
                        <div class="admin-links">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/festivais">Festivais</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/sessoes">Sessoes</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/acessos">Acessos</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/compras">Compras</MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">Estado</span>
                        <h2>Proximas sessoes</h2>
                        @if (_sessoes.Count == 0)
                        {
                            <p class="admin-muted">Sem sessoes disponiveis.</p>
                        }
                        else
                        {
                            <div class="admin-lista">
                                @foreach (var sessao in _sessoes.Take(5))
                                {
                                    <a href="@($"/visualizar/sessao/{sessao.Id}")">
                                        <span>@sessao.Inicio.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                        <strong>@TituloSessao(sessao)</strong>
                                    </a>
                                }
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </section>

            <section class="admin-acoes">
                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">Premios</span>
                        <h2>Criar premio de festival</h2>
                        <div class="admin-lista">
                            <select value="@_festivalPremioSelecionadoId" @onchange="SelecionarFestivalPremio">
                                <option value="0">Selecionar festival</option>
                                @foreach (var festival in _festivais)
                                {
                                    <option value="@festival.Id">@festival.Name</option>
                                }
                            </select>
                            <input placeholder="Nome do premio" @bind="_novoPremio.Nome" />
                            <textarea placeholder="Descricao" @bind="_novoPremio.Descricao"></textarea>
                            <input type="datetime-local"
                                   @bind-value="_novoPremio.DataAberturaVotacao"
                                   @bind-value:format="yyyy-MM-ddTHH:mm" />
                            <input type="datetime-local"
                                   @bind-value="_novoPremio.DataFechoVotacao"
                                   @bind-value:format="yyyy-MM-ddTHH:mm" />
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(_festivalPremioSelecionadoId == 0 || _aAtualizarPremios)"
                                       OnClick="CriarPremio">
                                Criar
                            </MudButton>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_mensagemPremios))
                        {
                            <p class="admin-muted">@_mensagemPremios</p>
                        }
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">Votacao</span>
                        <h2>Premios do festival</h2>
                        @if (_premiosFestival.Count == 0)
                        {
                            <p class="admin-muted">Seleciona um festival com premios criados.</p>
                        }
                        else
                        {
                            <div class="admin-lista">
                                @foreach (var premio in _premiosFestival)
                                {
                                    <div>
                                        <strong>@premio.Nome</strong>
                                        <span>@premio.EstadoPremio</span>
                                        <MudButton Size="Size.Small" Disabled="@_aAtualizarPremios" OnClick="() => AbrirPremio(premio.Id)">Abrir</MudButton>
                                        <MudButton Size="Size.Small" Disabled="@_aAtualizarPremios" OnClick="() => FecharPremio(premio.Id)">Fechar</MudButton>
                                        <MudButton Size="Size.Small" Disabled="@_aAtualizarPremios" OnClick="() => PublicarPremio(premio.Id)">Publicar</MudButton>
                                    </div>
                                }
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </section>

            <section class="admin-acoes">
                <MudCard Elevation="0" Class="cinema-panel">
                    <MudCardContent>
                        <span class="cinema-kicker">Vencedores</span>
                        <h2>Resultados publicados</h2>
                        @if (_resultadosPremios.Count == 0)
                        {
                            <p class="admin-muted">Sem vencedores publicados para o festival selecionado.</p>
                        }
                        else
                        {
                            <div class="admin-lista">
                                @foreach (var resultado in _resultadosPremios)
                                {
                                    <div>
                                        <strong>@resultado.NomePremio</strong>
                                        <span>@resultado.TituloFilmeVencedor - @resultado.TotalVotos votos</span>
                                    </div>
                                }
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </section>
        }
    </section>
</main>

@code {
    private readonly List<MetricaAdmin> _metricas = new();
    private List<FilmeDTO> _filmes = new();
    private List<SessaoDTO> _sessoes = new();
    private List<FestivalDTO> _festivais = new();
    private List<PremioFestivalDTO> _premiosFestival = new();
    private List<ResultadoPremioFestivalDTO> _resultadosPremios = new();
    private List<FilmeDTO> _resultadosTmdb = new();
    private CriarPremioFestivalDTO _novoPremio = new()
    {
        DataAberturaVotacao = DateTime.Today,
        DataFechoVotacao = DateTime.Today.AddDays(7),
    };
    private CriarFestivalDTO _novoFestival = new();
    private AssociarFilmeFestivalDTO _associacao = new();
    private CriarSessaoDTO _novaSessao = new()
    {
        Inicio = DateTime.Today.AddDays(1).AddHours(20),
        Fim = DateTime.Today.AddDays(1).AddHours(22),
        Tipo = 2,
        TemChatAoVivo = true,
    };
    private int _festivalOperacaoId;
    private int _festivalPremioSelecionadoId;
    private bool _aCarregar = true;
    private bool _aAtualizarOperacao;
    private bool _aAtualizarPremios;
    private string? _erro;
    private string? _mensagemOperacao;
    private string? _mensagemPremios;
    private string? _pesquisaTmdb;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _filmes = await FilmeService.ObterFilmesAsync();
            _festivais = await FestivalService.ObterFestivaisAsync();
            _sessoes = await SessaoService.ObterSessoesDisponiveisAsync();
            var acessos = await AcessoService.ObterAcessosAsync();

            _metricas.AddRange(
                new[]
                {
                    new MetricaAdmin("Filmes", _filmes.Count, Icons.Material.Filled.Movie, Color.Primary),
                    new MetricaAdmin("Festivais", _festivais.Count, Icons.Material.Filled.Festival, Color.Secondary),
                    new MetricaAdmin("Sessoes", _sessoes.Count, Icons.Material.Filled.Event, Color.Warning),
                    new MetricaAdmin("Acessos", acessos.Count, Icons.Material.Filled.ConfirmationNumber, Color.Success),
                }
            );

            if (_festivais.Count > 0)
            {
                _festivalPremioSelecionadoId = _festivais[0].Id;
                await CarregarPremiosSelecionados();
            }
        }
        catch
        {
            _erro = "Nao foi possivel carregar os dados administrativos.";
        }
        finally
        {
            _aCarregar = false;
        }
    }

    private static string TituloSessao(SessaoDTO sessao)
    {
        return string.IsNullOrWhiteSpace(sessao.Filme)
            ? $"Sessao #{sessao.Id}"
            : sessao.Filme;
    }

    private async Task CriarFestival()
    {
        await ExecutarOperacaoAsync(async () =>
        {
            var festival = await FestivalService.CriarAsync(_novoFestival);
            _festivais.Add(festival);
            _novoFestival = new CriarFestivalDTO();
            _mensagemOperacao = "Festival criado.";
        });
    }

    private async Task AdicionarFilmeAoFestival()
    {
        await ExecutarOperacaoAsync(async () =>
        {
            await FestivalService.AssociarFilmeAsync(_festivalOperacaoId, _associacao);
            _associacao = new AssociarFilmeFestivalDTO();
            _mensagemOperacao = "Filme adicionado ao festival.";
        });
    }

    private async Task CriarSessao()
    {
        await ExecutarOperacaoAsync(async () =>
        {
            var sessao = await SessaoService.CriarAsync(_novaSessao);
            _sessoes.Add(sessao);
            _novaSessao = new CriarSessaoDTO
            {
                Inicio = DateTime.Today.AddDays(1).AddHours(20),
                Fim = DateTime.Today.AddDays(1).AddHours(22),
                Tipo = 2,
                TemChatAoVivo = true,
            };
            _mensagemOperacao = "Sessao criada e bilhete de sessao gerado.";
        });
    }

    private async Task ExecutarOperacaoAsync(Func<Task> acao)
    {
        _aAtualizarOperacao = true;
        _mensagemOperacao = null;

        try
        {
            await acao();
        }
        catch (Exception ex)
        {
            _mensagemOperacao = ex.Message;
        }
        finally
        {
            _aAtualizarOperacao = false;
        }
    }

    private async Task CriarPremio()
    {
        await ExecutarPremioAsync(async () =>
        {
            await PremioFestivalService.CriarPremioAsync(_festivalPremioSelecionadoId, _novoPremio);
            _novoPremio = new CriarPremioFestivalDTO
            {
                DataAberturaVotacao = DateTime.Today,
                DataFechoVotacao = DateTime.Today.AddDays(7),
            };
            await CarregarPremiosSelecionados();
            _mensagemPremios = "Premio criado em rascunho.";
        });
    }

    private async Task AbrirPremio(int premioId)
    {
        await ExecutarPremioAsync(async () =>
        {
            await PremioFestivalService.AbrirVotacaoAsync(premioId);
            await CarregarPremiosSelecionados();
            _mensagemPremios = "Votacao aberta.";
        });
    }

    private async Task FecharPremio(int premioId)
    {
        await ExecutarPremioAsync(async () =>
        {
            await PremioFestivalService.FecharVotacaoAsync(premioId);
            await CarregarPremiosSelecionados();
            _mensagemPremios = "Votacao fechada.";
        });
    }

    private async Task PublicarPremio(int premioId)
    {
        await ExecutarPremioAsync(async () =>
        {
            await PremioFestivalService.PublicarResultadosAsync(premioId);
            await CarregarPremiosSelecionados();
            _mensagemPremios = "Resultado publicado.";
        });
    }

    private async Task CarregarPremiosSelecionados()
    {
        if (_festivalPremioSelecionadoId == 0)
        {
            _premiosFestival.Clear();
            return;
        }

        _premiosFestival = await PremioFestivalService.ObterPremiosPorFestivalAsync(
            _festivalPremioSelecionadoId
        );
        _resultadosPremios = await PremioFestivalService.ObterResultadosPorFestivalAsync(
            _festivalPremioSelecionadoId
        );
    }

    private async Task SelecionarFestivalPremio(ChangeEventArgs args)
    {
        _festivalPremioSelecionadoId = int.TryParse(args.Value?.ToString(), out var festivalId)
            ? festivalId
            : 0;

        await CarregarPremiosSelecionados();
    }

    private async Task ExecutarPremioAsync(Func<Task> acao)
    {
        _aAtualizarPremios = true;
        _mensagemPremios = null;

        try
        {
            await acao();
        }
        catch (Exception ex)
        {
            _mensagemPremios = ex.Message;
        }
        finally
        {
            _aAtualizarPremios = false;
        }
    }

    private async Task PesquisarTmdb()
    {
        await ExecutarOperacaoAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(_pesquisaTmdb) || _pesquisaTmdb.Trim().Length < 2)
                throw new InvalidOperationException("Escreve pelo menos 2 caracteres.");

            _resultadosTmdb = await TmdbService.PesquisarAsync(_pesquisaTmdb.Trim());
            _mensagemOperacao = _resultadosTmdb.Count == 0
                ? "Sem resultados TMDB."
                : $"{_resultadosTmdb.Count} resultados encontrados.";
        });
    }

    private async Task ImportarTmdb(int tmdbId)
    {
        await ExecutarOperacaoAsync(async () =>
        {
            var filme = await FilmeService.ImportarTmdbAsync(tmdbId);
            _filmes = await FilmeService.ObterFilmesAsync();
            _mensagemOperacao = $"Filme adicionado ao catalogo: {filme.Titulo}.";
        });
    }

    private sealed record MetricaAdmin(string Rotulo, int Valor, string Icone, Color Cor);
}
