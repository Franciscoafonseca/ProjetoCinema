@page "/listas"
@attribute [Authorize]
@inject ListaService ListaService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using System.Text.RegularExpressions

<PageTitle>As minhas listas - Online Cinema Festival</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <RedirectToLogin ReturnPath="/listas" />
    </NotAuthorized>
    <Authorized Context="auth">
        <div class="listas-container">
            <header class="listas-cabecalho">
                <div class="listas-cabecalho-copy">
                    <span class="listas-eyebrow">Biblioteca pessoal</span>
                    <h1 class="listas-titulo">As minhas listas</h1>
                    <p class="listas-subtitulo">Organiza filmes para ver, vistos, favoritos e colecoes personalizadas.</p>
                </div>

                <div class="listas-cabecalho-acoes">
                    <div class="listas-stat">
                        <strong>@_listas.Count</strong>
                        <span>listas</span>
                    </div>
                    <div class="listas-stat">
                        <strong>@_listas.Sum(l => l.TotalFilmes)</strong>
                        <span>filmes</span>
                    </div>
                    <button class="btn-nova-lista" @onclick="AbrirFormNovaLista">Nova lista</button>
                </div>
            </header>

            @if (_mostrarFormNovaLista)
            {
                <section class="form-nova-lista">
                    <div class="form-nova-lista-topo">
                        <div>
                            <span class="form-eyebrow">Lista personalizada</span>
                            <h3>Nova lista</h3>
                        </div>
                        <button type="button" class="btn-fechar-form" title="Fechar" @onclick="FecharFormNovaLista">x</button>
                    </div>

                    <EditForm Model="_novaLista" OnValidSubmit="CriarLista">
                        <DataAnnotationsValidator />

                        <div class="form-linha">
                            <div class="form-campo">
                                <label>Nome</label>
                                <InputText class="form-input" @bind-Value="_novaLista.Name" placeholder="Ex.: Para rever" />
                                <ValidationMessage For="@(() => _novaLista.Name)" class="campo-erro" />
                            </div>
                            <div class="form-campo form-campo-check">
                                <InputCheckbox @bind-Value="_novaLista.IsPublic" id="publica" />
                                <label for="publica">Publica</label>
                            </div>
                        </div>

                        <div class="form-campo">
                            <label>Descricao opcional</label>
                            <InputTextArea class="form-input form-textarea" @bind-Value="_novaLista.Description" rows="2" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_erroForm))
                        {
                            <p class="form-erro">@_erroForm</p>
                        }

                        <div class="form-acoes">
                            <button type="button" class="btn-secundario" @onclick="FecharFormNovaLista">Cancelar</button>
                            <button type="submit" class="btn-primario" disabled="@_aCriar">
                                @(_aCriar ? "A criar..." : "Criar lista")
                            </button>
                        </div>
                    </EditForm>
                </section>
            }

            @if (_loading)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>A carregar listas...</p>
                </div>
            }
            else if (_erro != null)
            {
                <p class="erro-state">@_erro</p>
            }
            else if (_listas.Count == 0)
            {
                <section class="empty-state">
                    <span>Nenhuma lista</span>
                    <h2>Ainda nao tens listas</h2>
                    <p>Cria a primeira ou faz registo novamente. As listas padrao sao criadas automaticamente.</p>
                    <button class="btn-primario" @onclick="AbrirFormNovaLista">Criar lista</button>
                </section>
            }
            else
            {
                <div class="listas-stack">
                    @foreach (var lista in _listas)
                    {
                        <section class="lista-bloco">
                            <header class="lista-bloco-cabecalho">
                                <div class="lista-bloco-cabecalho-conteudo">
                                    <div>
                                        <div class="lista-bloco-titulo-linha">
                                            <span class="lista-icone">@ObterIcone(lista.Tipo)</span>
                                            <h2 class="lista-bloco-nome">@lista.Name</h2>
                                        </div>
                                        <div class="lista-bloco-meta">
                                            <span class="lista-tipo">@lista.TipoNome</span>
                                            <span>@lista.TotalFilmes @(lista.TotalFilmes == 1 ? "filme" : "filmes")</span>
                                            @if (lista.IsPublic)
                                            {
                                                <span class="badge-publica">Publica</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(lista.Description))
                                        {
                                            <p class="lista-bloco-descricao">@lista.Description</p>
                                        }
                                    </div>
                                    @if (lista.Tipo == 0)
                                    {
                                        <button class="btn-apagar-lista"
                                                title="Apagar lista"
                                                disabled="@_aApagar"
                                                @onclick="() => ApagarLista(lista)">
                                            Apagar
                                        </button>
                                    }
                                </div>
                            </header>

                            @if (lista.Items.Count == 0)
                            {
                                <div class="lista-vazia">
                                    <span>Lista vazia</span>
                                    <p>Adiciona filmes a partir da pagina de detalhes de um filme.</p>
                                </div>
                            }
                            else
                            {
                                <div class="lista-grid">
                                    @foreach (var item in lista.Items)
                                    {
                                        <article class="lista-item-card">
                                            <div class="lista-item-poster" @onclick="() => AbrirFilme(item.FilmeId)">
                                                @if (!string.IsNullOrWhiteSpace(item.CapaUrl))
                                                {
                                                    <img src="@item.CapaUrl" alt="@item.Titulo" />
                                                }
                                                else
                                                {
                                                    <div class="lista-item-sem-capa">CineHub</div>
                                                }
                                                <button class="lista-item-remover"
                                                        title="Remover"
                                                        @onclick="() => RemoverFilme(lista.Id, item.FilmeId)"
                                                        @onclick:stopPropagation="true">
                                                    x
                                                </button>
                                            </div>
                                            <div class="lista-item-info">
                                                <h4 class="lista-item-titulo">@item.Titulo</h4>
                                                @if (!string.IsNullOrWhiteSpace(item.Genero))
                                                {
                                                    <span class="lista-item-genero">@item.Genero</span>
                                                }
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<ListaPessoalDTO> _listas = new();
    private bool _loading = true;
    private string? _erro;

    private bool _mostrarFormNovaLista;
    private CriarListaRequest _novaLista = new();
    private bool _aCriar;
    private string? _erroForm;
    private bool _aApagar;

    protected override async Task OnInitializedAsync()
    {
        await CarregarListasAsync();
    }

    private async Task CarregarListasAsync()
    {
        try
        {
            _loading = true;
            _erro = null;
            _listas = await ListaService.ObterMinhasListasAsync();
        }
        catch
        {
            _erro = "Erro ao carregar listas. Tenta novamente.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void AbrirFormNovaLista()
    {
        _novaLista = new CriarListaRequest();
        _erroForm = null;
        _mostrarFormNovaLista = true;
    }

    private void FecharFormNovaLista()
    {
        _mostrarFormNovaLista = false;
        _erroForm = null;
    }

    private async Task CriarLista()
    {
        _aCriar = true;
        _erroForm = null;

        try
        {
            ValidarNovaLista();
            var nova = await ListaService.CriarAsync(_novaLista);
            _listas.Add(nova);
            FecharFormNovaLista();
        }
        catch (Exception ex)
        {
            _erroForm = ex.Message;
        }
        finally
        {
            _aCriar = false;
        }
    }

    private async Task RemoverFilme(int listaId, int filmeId)
    {
        try
        {
            await ListaService.RemoverFilmeAsync(listaId, filmeId);

            var lista = _listas.FirstOrDefault(l => l.Id == listaId);
            if (lista != null)
            {
                lista.Items.RemoveAll(i => i.FilmeId == filmeId);
                lista.TotalFilmes = lista.Items.Count;
            }
        }
        catch
        {
            _erro = "Nao foi possivel remover o filme.";
        }
    }

    private async Task ApagarLista(ListaPessoalDTO lista)
    {
        if (_aApagar) return;

        var confirmou = await JS.InvokeAsync<bool>(
            "confirm",
            $"Tens a certeza que queres apagar a lista \"{lista.Name}\"? Esta acao nao pode ser revertida.");

        if (!confirmou) return;

        _aApagar = true;
        try
        {
            await ListaService.RemoverListaAsync(lista.Id);
            _listas.Remove(lista);
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _aApagar = false;
        }
    }

    private void AbrirFilme(int filmeId) => Nav.NavigateTo($"/filmes/{filmeId}");

    private void ValidarNovaLista()
    {
        var nome = _novaLista.Name?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(nome))
            throw new InvalidOperationException("O nome da lista e obrigatorio.");

        if (nome.Length < 3)
            throw new InvalidOperationException("O nome da lista deve ter pelo menos 3 caracteres.");

        if (!Regex.IsMatch(nome, @"^[\p{L}\p{N}\s._'-]+$"))
            throw new InvalidOperationException("O nome da lista contem caracteres invalidos.");

        if (_listas.Any(l => l.Name.Equals(nome, StringComparison.OrdinalIgnoreCase)))
            throw new InvalidOperationException("Ja existe uma lista com esse nome.");

        _novaLista.Name = nome;
    }

    private static string ObterIcone(int tipo) => tipo switch
    {
        1 => "Ver",
        2 => "Visto",
        3 => "Fav",
        _ => "Lista",
    };
}
