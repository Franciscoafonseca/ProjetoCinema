@inject NavigationManager Nav

<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <LayoutView Layout="@typeof(MainLayout)">
                            <section class="auth-required sky-card">
                                <span class="sky-chip">Acesso protegido</span>
                                <h1>Inicia sessao</h1>
                                <p>Precisas de uma conta para aceder a esta area do festival.</p>
                                <a class="sky-btn-primary" href="@LoginUrl()">Entrar</a>
                            </section>
                        </LayoutView>
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </ChildContent>
            <ErrorContent Context="erro">
                <LayoutView Layout="@typeof(MainLayout)">
                    <section class="sky-empty-state app-error-state" role="alert">
                        <img src="images/illustrations/empty-state-reel.svg" alt="" />
                        <h1>Algo correu mal.</h1>
                        <p>A pagina encontrou um erro, mas a aplicacao continua disponivel.</p>
                        <button class="sky-btn-secondary" type="button" @onclick="Recuperar">Tentar novamente</button>
                    </section>
                </LayoutView>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
</Router>

@code {
    private ErrorBoundary? _errorBoundary;

    private string LoginUrl()
    {
        var relativo = Nav.ToBaseRelativePath(Nav.Uri);
        var destino = string.IsNullOrWhiteSpace(relativo) ? "/" : "/" + relativo;
        return "/login?returnUrl=" + Uri.EscapeDataString(destino);
    }

    private void Recuperar()
    {
        _errorBoundary?.Recover();
        Nav.NavigateTo("/");
    }
}
