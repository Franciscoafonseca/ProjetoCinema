@inherits LayoutComponentBase
@inject AutenticacaoService AutenticacaoService
@inject NavigationManager Nav

<MudThemeProvider Theme="_tema" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="layout">
    <header class="navbar-topo">
        <a class="logo" href="">
            <img class="logo-mark" src="images/logos/cinehub-icon-branco.png" alt="" />
            <span>CineHub</span>
        </a>

        <nav class="nav-centro" aria-label="Navegacao principal">
            <NavLink class="nav-btn" href="" Match="NavLinkMatch.All">Inicio</NavLink>
            <NavLink class="nav-btn" href="catalogo">Catalogo</NavLink>
            <NavLink class="nav-btn" href="festivais">Festivais</NavLink>
            <NavLink class="nav-btn" href="sessoes">Sessoes</NavLink>
            <NavLink class="nav-btn" href="about">Sobre</NavLink>
            <NavLink class="nav-btn" href="suporte">Suporte</NavLink>

            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-btn" href="acessos">Acessos</NavLink>
                    <NavLink class="nav-btn" href="compras">Compras</NavLink>
                    <NavLink class="nav-btn" href="listas">Listas</NavLink>
                    <NavLink class="nav-btn" href="comunidades">Comunidades</NavLink>
                    <AuthorizeView Roles="Administrador" Context="adminAuth">
                        <Authorized>
                            <NavLink class="nav-btn" href="admin">Admin</NavLink>
                        </Authorized>
                    </AuthorizeView>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="nav-direita">
            <AuthorizeView>
                <Authorized Context="auth">
                    <NavLink class="nav-icon-btn" href="carrinho" title="Carrinho">Carrinho</NavLink>
                    <NavLink class="nav-user" href="perfil">@ObterNome(auth.User.Identity?.Name)</NavLink>
                    <button class="nav-btn nav-btn-sair" @onclick="Sair">Sair</button>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-btn" href="login">Entrar</NavLink>
                    <NavLink class="nav-btn nav-btn-destaque" href="registo">Registar</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="conteudo">
        @Body
    </main>
</div>

@code {
    private readonly MudTheme _tema = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#0072ce",
            Secondary = "#ff4f6d",
            Background = "#050913",
            Surface = "#0d1323",
            AppbarBackground = "#050913",
            TextPrimary = "#ffffff",
            TextSecondary = "#c8c8c8",
            ActionDefault = "#d8d8d8",
            DrawerBackground = "#171717",
        }
    };

    private async Task Sair()
    {
        await AutenticacaoService.TerminarSessaoAsync();
        Nav.NavigateTo("/");
    }

    private static string ObterNome(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome))
            return "Perfil";

        return nome.Contains('@') ? nome.Split('@')[0] : nome;
    }
}
