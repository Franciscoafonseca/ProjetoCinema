@inject NavigationManager Nav

<article class="filme-card" @onclick="Navegar">
    <div class="filme-card-poster">
        <img src="@ImagemFilme" alt="@Filme.Titulo" />
        <div class="filme-card-overlay">
            <span class="ver-detalhes">Ver detalhes</span>
        </div>
    </div>

    <div class="filme-card-info">
        @if (!string.IsNullOrWhiteSpace(Filme.Genero))
        {
            <span class="filme-card-genero">@Filme.Genero</span>
        }

        <h3 class="filme-card-titulo">@Filme.Titulo</h3>

        @if (!string.IsNullOrWhiteSpace(Filme.Classificacao))
        {
            <div class="filme-card-rating">
                <span class="rating-label">Nota</span>
                <span>@Filme.Classificacao</span>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public FilmeDTO Filme { get; set; } = new();

    private string ImagemFilme =>
        string.IsNullOrWhiteSpace(Filme.CapaUrl)
            ? "images/logos/cinehub-icon-cor.png"
            : Filme.CapaUrl;

    private void Navegar() => Nav.NavigateTo($"/filmes/{Filme.Id}");
}
